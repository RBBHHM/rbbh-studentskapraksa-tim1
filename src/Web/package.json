{
  "name": "connected-parties-web",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "sideEffects": ["**/*.css"],
  "type": "module",
  "scripts": {
    "config:dev": "node scripts/config/generate-runtime-config.mjs .runtime",
    "dev": "pnpm.cmd config:dev && webpack serve --config webpack.config.cjs",
    "dev:api": "cmd /c ..\\..\\scripts\\dev-api.cmd",
    "build": "webpack --config webpack.config.cjs --mode production && node scripts/config/generate-runtime-config.mjs dist",
    "build:api": "dotnet build ../../RelatedPartiesRegister/RelatedPartiesRegister.csproj --configuration Release",
    "openapi:generate": "node scripts/openapi/generate.mjs",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "localization:build": "node scripts/localization/build-release.mjs",
    "localization:validate": "node scripts/localization/validate-keys.mjs",
    "test": "node --test tests/node/*.test.mjs",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\scripts\\testing\\Test-LocalApi.ps1",
    "publish:iis": "pnpm.cmd build && node scripts/deployment/create-iis-zip.mjs"
  },
