@page "/"
@page "/app"
@inject RBI.Authorization.IRbiPermissionService Permissions
@inject IProfileApi Profile
@inject AuthenticationStateProvider AuthenticationState
<PageTitle>@T["app.title"]</PageTitle>
<HeroBar Title="@T["app.title"]" Description="@T["app.welcome"]" />
<AuthorizeView>
    <Authorized>
        <RbiGrid Columns="RbiGridColumns.Two">
            @if (_physical)
            {
                <RbiCard Title="@T["person.title"]">
                    <ChildContent><RbiText>@T["person.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/physical-persons">@T["person.title"]</RbiButton></Footer>
                </RbiCard>
            }
            @if (_reports)
            {
                <RbiCard Title="@T["reports.title"]">
                    <ChildContent><RbiText>@T["reports.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/reports">@T["reports.title"]</RbiButton></Footer>
                </RbiCard>
            }
            @if (_capital)
            {
                <RbiCard Title="@T["notifications.title"]">
                    <ChildContent><RbiText>@T["notifications.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/notifications">@T["notifications.title"]</RbiButton></Footer>
                </RbiCard>
                <RbiCard Title="@T["capital.title"]">
                    <ChildContent><RbiText>@T["capital.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/capital">@T["capital.title"]</RbiButton></Footer>
                </RbiCard>
            }
            @if (_limits)
            {
                <RbiCard Title="@T["limit.title"]">
                    <ChildContent><RbiText>@T["limit.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/limits">@T["limit.title"]</RbiButton></Footer>
                </RbiCard>
            }
            @if (_legal)
            {
                <RbiCard Title="@T["legal.title"]">
                    <ChildContent><RbiText>@T["legal.subtitle"]</RbiText></ChildContent>
                    <Footer><RbiButton Href="/app/legal-persons">@T["legal.title"]</RbiButton></Footer>
                </RbiCard>
            }
            @if (_admin)
            {
                <RbiCard Title="@T["codes.title"]"><ChildContent><RbiText>@T["codes.subtitle"]</RbiText></ChildContent><Footer><RbiButton Href="/app/admin/code-lists">@T["codes.title"]</RbiButton></Footer></RbiCard>
                <RbiCard Title="@T["period.title"]"><ChildContent><RbiText>@T["period.subtitle"]</RbiText></ChildContent><Footer><RbiButton Href="/app/admin/period">@T["period.title"]</RbiButton></Footer></RbiCard>
                <RbiCard Title="@T["users.title"]"><ChildContent><RbiText>@T["users.subtitle"]</RbiText></ChildContent><Footer><RbiButton Href="/app/admin/users">@T["users.title"]</RbiButton></Footer></RbiCard>
                <RbiCard Title="@T["audit.title"]"><ChildContent><RbiText>@T["audit.subtitle"]</RbiText></ChildContent><Footer><RbiButton Href="/app/admin/audit">@T["audit.title"]</RbiButton></Footer></RbiCard>
            }
            <RbiCard Title="@T["nav.profile"]">
                <ChildContent><RbiText>@T["profile.description"]</RbiText></ChildContent>
                <Footer><RbiButton Href="/app/profile">@T["nav.profile"]</RbiButton></Footer>
            </RbiCard>
            <RbiCard Title="@T["guide.title"]"><ChildContent><RbiText>@T["guide.subtitle"]</RbiText></ChildContent><Footer><RbiButton Href="/app/guide">@T["guide.title"]</RbiButton></Footer></RbiCard>
        </RbiGrid>
    </Authorized>
    <NotAuthorized><IdentityNotice /></NotAuthorized>
</AuthorizeView>
@code {
    private bool _physical, _legal, _limits, _capital, _admin, _reports;
    protected override async Task OnInitializedAsync()
    {
        if ((await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated != true) return;
        try { _admin = ApplicationAccess.IsAdministrator(await Profile.GetAsync()); _reports = await Permissions.HasPermissionAsync("reports.read"); _physical = await Permissions.HasPermissionAsync("fl.read"); _legal = await Permissions.HasPermissionAsync("pl.read"); _limits = await Permissions.HasPermissionAsync("limiti.read"); _capital = await Permissions.HasPermissionAsync("kapital.read"); }
        catch (RegistryApiException) { _physical = _legal = _limits = _capital = _admin = _reports = false; }
    }
}
