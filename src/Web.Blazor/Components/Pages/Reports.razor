@page "/app/reports"
@using RBI.DesignSystem.Components.Forms
@using Microsoft.JSInterop
@using RBI.ApiCore
@using System.Net
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IReportsApi Api
@inject FileDelivery Files

<PageTitle>@T["reports.title"]</PageTitle>
<HeroBar Title="@T["reports.title"]" Description="@T["reports.subtitle"]" />
@if (!_authenticated && !_refreshing) { <IdentityNotice /> }
else if (_authenticated && !_canRead && !_refreshing)
{
    <RbiAlert Title="@T[_loadError ?? "errors.forbidden"]" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else if (_authenticated)
{
    @if (_notice is not null) { <div role="status"><RbiAlert Title="@T[_notice]" /></div> }
    @if (_actionError is not null) { <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_actionError]" Announcement="RbiAlertAnnouncement.Assertive" /> }
    <div class="registry-toolbar">
        <RbiButton Disabled="_busy" Loading="_refreshing" LoadingLabel="@T["state.loading"]" OnClick="LoadAsync" Variant="RbiButtonVariant.Secondary">@T["common.refresh"]</RbiButton>
        <RbiButton Disabled="@(_busy || _refreshing)" OnClick="ExportAllAsync" Variant="RbiButtonVariant.Secondary">@T["reports.all-clients"]</RbiButton>
        @if (_canGenerate)
        {
            <RbiButton Disabled="@(_busy || _refreshing)" OnClick="() => GenerateAsync(false)">@T["reports.generate-daily"]</RbiButton>
            <label for="report-year">@T["reports.year"]</label>
            <RbiSelect TValue="int" Id="report-year" @bind-Value="_year" Disabled="@(_busy || _refreshing)">
                @foreach (var year in Enumerable.Range(2000, DateTime.UtcNow.Year - 1999)) { <option value="@year">@year</option> }
            </RbiSelect>
            <label for="report-month">@T["reports.month"]</label>
            <RbiSelect TValue="int" Id="report-month" @bind-Value="_month" Disabled="@(_busy || _refreshing)">
                @for (var month = 1; month <= 12; month++) { <option value="@month">@System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetMonthName(month)</option> }
            </RbiSelect>
            <RbiButton Disabled="@(_busy || _refreshing || !ValidPeriod)" OnClick="() => GenerateAsync(true)">@T["reports.generate-monthly"]</RbiButton>
        }
    </div>
    @if (_canGenerate) { <p>@T["reports.persist-help"]</p> }
    <label for="report-identifier">@T["reports.identifier"]</label>
    <RbiInput Id="report-identifier" @bind-Value="_identifier" UpdateMode="RbiInputUpdateMode.Input" maxlength="13" inputmode="numeric"
              aria-invalid="@(!string.IsNullOrEmpty(_identifier) && !ValidIdentifier ? "true" : null)" aria-describedby="report-identifier-help" />
    <p id="report-identifier-help">@T["reports.identifier-help"]</p>
    <div class="registry-toolbar"><RbiButton Disabled="@(_busy || _refreshing || !ValidIdentifier)" OnClick="ExportClientAsync" Variant="RbiButtonVariant.Secondary">@T["reports.client-download"]</RbiButton></div>
    @if (_refreshing) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
    else if (_loadError is not null)
    {
        <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_loadError]" />
        <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
    }
    else if (!Records.Any()) { <RbiText>@T["reports.empty"]</RbiText> }
    else
    {
        <RbiTable AccessibleLabel="@T["reports.title"]" Class="registry-reports-table">
            <caption>@T["reports.title"]</caption>
            <thead><tr><th scope="col">@T["reports.type"]</th><th scope="col">@T["reports.date"]</th><th scope="col">@T["reports.clients"]</th><th scope="col">@T["reports.breached"]</th><th scope="col">@T["reports.exposure"]</th><th scope="col">@T["reports.author"]</th><th scope="col">@T["common.actions"]</th></tr></thead>
            <tbody>@foreach (var report in Records)
            {
                <tr @key="report.Id"><td>@TypeLabel(report.ReportType)</td><td>@report.ReportDate.ToString("d")</td><td>@report.TotalClients</td><td>@report.ClientsWithBreachedLimit</td><td>@report.TotalExposure.ToString("N2")</td><td>@report.CreatedBy</td><td><RbiButton Disabled="_busy" OnClick="() => DownloadSnapshotAsync(report.Id)" Variant="RbiButtonVariant.Secondary">@T["reports.download"]</RbiButton></td></tr>
            }</tbody>
        </RbiTable>
        @if (DailyPages > 1)
        {
            <h2>@T["reports.daily-pages"]</h2>
            <RbiPagination CurrentPage="_dailyPage" CurrentPageChanged="ChangeDailyAsync" TotalPages="DailyPages" AccessibleLabel="@T["reports.daily-pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("reports.daily-page", page))" />
        }
        @if (MonthlyPages > 1)
        {
            <h2>@T["reports.monthly-pages"]</h2>
            <RbiPagination CurrentPage="_monthlyPage" CurrentPageChanged="ChangeMonthlyAsync" TotalPages="MonthlyPages" AccessibleLabel="@T["reports.monthly-pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("reports.monthly-page", page))" />
        }
    }
}
else { <div role="status">@T["state.loading"]</div> }

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public Reports() => _token = _lifetime.Token;
    private ReportArchive _daily = new([], 0, 1, 100), _monthly = new([], 0, 1, 100);
    private int _dailyPage = 1, _monthlyPage = 1, _year = DateTime.UtcNow.Year, _month = DateTime.UtcNow.Month;
    private string? _identifier, _loadError, _actionError, _notice;
    private bool _disposed, _authenticated, _canRead, _canGenerate, _busy, _refreshing = true;
    private int DailyPages => Math.Max(1, (int)Math.Ceiling(_daily.Total / 100d));
    private int MonthlyPages => Math.Max(1, (int)Math.Ceiling(_monthly.Total / 100d));
    private bool ValidPeriod => _year >= 2000 && _year <= DateTime.UtcNow.Year && _month is >= 1 and <= 12;
    private bool ValidIdentifier => ReportsApi.ValidIdentifier(_identifier);
    private string TypeLabel(string? value) => value?.ToUpperInvariant() switch { "DAILY" => T["reports.daily"], "MONTHLY" => T["reports.monthly"], _ => string.IsNullOrWhiteSpace(value) ? "—" : value };
    private IEnumerable<ReportEntry> Records => _daily.Items.Concat(_monthly.Items).OrderByDescending(item => item.CreatedAt);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_disposed) return; _refreshing = true; _loadError = null; _canRead = _canGenerate = false;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token);
            _canRead = ApplicationAccess.IsKnownApplicationUser(profile);
            if (!_canRead) { _loadError = "errors.forbidden"; return; }
            _canGenerate = profile.Permissions.Contains("KAPITAL_CREATE");
            var daily = Api.ListAsync(ReportKind.Daily, _dailyPage, _token);
            var monthly = Api.ListAsync(ReportKind.Monthly, _monthlyPage, _token);
            await Task.WhenAll(daily, monthly); _daily = await daily; _monthly = await monthly;
            if (_dailyPage > DailyPages) { _dailyPage = DailyPages; _daily = await Api.ListAsync(ReportKind.Daily, _dailyPage, _token); }
            if (_monthlyPage > MonthlyPages) { _monthlyPage = MonthlyPages; _monthly = await Api.ListAsync(ReportKind.Monthly, _monthlyPage, _token); }
        }
        catch (RegistryApiException exception) { _loadError = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _refreshing = false; }
    }
    private async Task ChangeDailyAsync(int page) { if (_busy || _refreshing || page < 1 || page > DailyPages) return; _dailyPage = page; await LoadAsync(); }
    private async Task ChangeMonthlyAsync(int page) { if (_busy || _refreshing || page < 1 || page > MonthlyPages) return; _monthlyPage = page; await LoadAsync(); }
    private async Task GenerateAsync(bool monthly)
    {
        if (!_authenticated || !_canRead || !_canGenerate || _busy || _refreshing || (monthly && !ValidPeriod)) return;
        _busy = true; _actionError = _notice = null;
        try
        {
            var report = monthly ? await Api.GenerateMonthlyAsync(_year, _month, _token) : await Api.GenerateDailyAsync(_token);
            _notice = "reports.generated"; await LoadAsync();
            try { await Files.DownloadAsync(await Api.DownloadAsync(report.Id, _token), _token); }
            catch (RegistryApiException) { _actionError = "reports.generated-download-failed"; }
            catch (JSDisconnectedException) { _actionError = "reports.generated-download-failed"; }
        }
        catch (RegistryApiException exception)
        {
            _actionError = exception.StatusCode is null || (int)exception.StatusCode >= 500 ? "reports.generation-unknown" : exception.MessageKey;
            if (exception.StatusCode == HttpStatusCode.Forbidden) _canGenerate = false;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private Task ExportAllAsync() => DownloadFileAsync(token => Api.ExportAllAsync(token));
    private Task DownloadSnapshotAsync(Guid id) => DownloadFileAsync(token => Api.DownloadAsync(id, token));
    private Task ExportClientAsync() => ValidIdentifier ? DownloadFileAsync(token => Api.ExportClientAsync(_identifier!, token)) : Task.CompletedTask;
    private async Task DownloadFileAsync(Func<CancellationToken, Task<RbiApiFile>> request)
    {
        if (!_authenticated || !_canRead || _busy || _refreshing) return; _busy = true; _actionError = null;
        try { await Files.DownloadAsync(await request(_token), _token); }
        catch (RegistryApiException exception) { _actionError = exception.MessageKey; }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
