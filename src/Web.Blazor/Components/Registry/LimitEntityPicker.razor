@using RBI.DesignSystem.Components.Forms
@implements IDisposable
@inject ILimitsApi Api

<div>
    <label for="@(Id + "-search")">@T["limit.entity-search"]</label>
    <div class="registry-toolbar">
        <RbiInput Id="@(Id + "-search")" @bind-Value="_search" Disabled="@(Disabled || _searching)" />
        <RbiButton Disabled="@Disabled" Loading="_searching" LoadingLabel="@T["state.loading"]" OnClick="SearchAsync" Variant="RbiButtonVariant.Secondary">@T["common.search"]</RbiButton>
    </div>
    <RbiSelect TValue="Guid?" Id="@Id" Value="Value" ValueChanged="SelectAsync" ValueExpression="@(ValueExpression ?? (() => Value))" Disabled="Disabled" Placeholder="@T["common.select"]">
        @foreach (var item in _options) { <option value="@item.Id">@item.Name · @item.MaticniBroj</option> }
    </RbiSelect>
    <p>@T["limit.lookup-help"]</p>
    @if (_loading) { <div role="status">@T["state.loading"]</div> }
    @if (_error is not null)
    {
        <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
        <RbiButton Disabled="@Disabled" OnClick="RetryAsync" Variant="RbiButtonVariant.Secondary">@T["state.retry"]</RbiButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<Guid?>>? ValueExpression { get; set; }
    [Parameter] public EventCallback<LimitEntityData?> DataChanged { get; set; }
    [Parameter] public bool RequireData { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _selection;
    private IReadOnlyList<LimitEntityOption> _options = [];
    private string? _search, _error;
    private bool _searching, _loading;
    protected override async Task OnInitializedAsync() { await SearchAsync(); if (Value.HasValue && RequireData) await LoadDataAsync(Value.Value); }
    private async Task SearchAsync()
    {
        if (Disabled || _searching) return;
        _searching = true; _error = null;
        try
        {
            var options = await Api.SearchEntitiesAsync(_search, _lifetime.Token);
            var selected = _options.FirstOrDefault(option => option.Id == Value);
            _options = selected is not null && !options.Any(option => option.Id == selected.Id) ? [.. options, selected] : options;
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _searching = false; }
    }
    private async Task SelectAsync(Guid? id)
    {
        if (Disabled) return;
        _selection?.Cancel();
        _loading = false; _error = null;
        Value = id; await ValueChanged.InvokeAsync(id); await DataChanged.InvokeAsync(null);
        if (id is { } selected && RequireData) await LoadDataAsync(selected);
    }
    private async Task LoadDataAsync(Guid id)
    {
        _selection?.Cancel(); _selection?.Dispose(); _selection = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _selection.Token; _loading = true; _error = null;
        try
        {
            var data = await Api.EntityDataAsync(id, token); token.ThrowIfCancellationRequested();
            if (!_options.Any(option => option.Id == id)) _options = [.. _options, new(id, data.Name, data.MaticniBroj, data.TaxNumber)];
            await DataChanged.InvokeAsync(data);
        }
        catch (RegistryApiException exception) { if (!token.IsCancellationRequested) _error = exception.MessageKey; }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }
    private async Task RetryAsync() { await SearchAsync(); if (Value is { } id && RequireData) await LoadDataAsync(id); }
    public void Dispose() { _lifetime.Cancel(); _selection?.Cancel(); _selection?.Dispose(); _lifetime.Dispose(); }
}
