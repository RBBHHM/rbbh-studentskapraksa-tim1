@using System.Globalization
@using RBI.Localization
@using RBI.DesignSystem.Components.Forms
@inject RbiCultureCatalog Cultures
@inject NavigationManager Navigation

<form action="@Action" method="post" data-enhance="false" class="app-language">
    <AntiforgeryToken />
    <RbiIcon Name="RbiIconName.Languages" Class="app-language__icon" />
    <label for="@Id" class="app-visually-hidden">@T["common.language"]</label>
    <RbiSelect TValue="string" id="@Id" @bind-Value="_culture">
        @foreach (var culture in Cultures.SupportedCultures)
        {
            <option value="@culture">@LanguageName(culture)</option>
        }
    </RbiSelect>
    <RbiButton Type="RbiButtonType.Submit" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Small" Class="app-language__apply">@T["common.apply"]</RbiButton>
</form>

@code {
    [Parameter] public string Id { get; set; } = "app-culture";
    private static string LanguageName(string culture) { var info = CultureInfo.GetCultureInfo(culture); return info.TextInfo.ToTitleCase(info.NativeName); }
    private string _culture = CultureInfo.CurrentUICulture.Name;
    private string Action => $"/rbi-localization/culture/{Uri.EscapeDataString(_culture)}?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
}
