<div class="registry-empty" role="status">
    @if (Title != string.Empty) { <h2 class="registry-empty__title">@(Title ?? T["state.empty-title"])</h2> }
    <p class="registry-empty__body">@Body</p>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public string Body { get; set; } = string.Empty;
}
