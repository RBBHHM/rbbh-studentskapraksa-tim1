@inject NavigationManager Navigation
@inject RBI.Authorization.IRbiPermissionService Permissions
@inject IProfileApi Profile
@inject AuthenticationStateProvider AuthenticationState

<nav aria-label="@T["nav.title"]">
    <RbiSidebarPart Kind="RbiSidebarPartKind.Menu">
        <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["nav.home"]" Href="/app" Icon="RbiIconName.Gauge" Active="@(IsActive("app") || IsActive(""))" /></RbiSidebarPart>
        @if (_physical)
        {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["person.title"]" Href="/app/physical-persons" Icon="RbiIconName.UserRound" Active="@IsActive("app/physical-persons")" /></RbiSidebarPart>
        }
        @if (_reports)
        {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["reports.title"]" Href="/app/reports" Icon="RbiIconName.Gauge" Active="@IsActive("app/reports")" /></RbiSidebarPart>
        }
        @if (_capital)
        {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["notifications.title"]" Href="/app/notifications" Icon="RbiIconName.Gauge" Active="@IsActive("app/notifications")" /></RbiSidebarPart>
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["capital.title"]" Href="/app/capital" Icon="RbiIconName.Gauge" Active="@IsActive("app/capital")" /></RbiSidebarPart>
        }
        @if (_limits)
        {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["limit.title"]" Href="/app/limits" Icon="RbiIconName.Gauge" Active="@IsActive("app/limits")" /></RbiSidebarPart>
        }
        @if (_legal)
        {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["legal.title"]" Href="/app/legal-persons" Icon="RbiIconName.UserRound" Active="@IsActive("app/legal-persons")" /></RbiSidebarPart>
        }
        @if (_admin) {
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["codes.title"]" Href="/app/admin/code-lists" Icon="RbiIconName.Gauge" Active="@IsActive("app/admin/code-lists")" /></RbiSidebarPart>
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["period.title"]" Href="/app/admin/period" Icon="RbiIconName.Gauge" Active="@IsActive("app/admin/period")" /></RbiSidebarPart>
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["users.title"]" Href="/app/admin/users" Icon="RbiIconName.UserRound" Active="@IsActive("app/admin/users")" /></RbiSidebarPart>
            <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["audit.title"]" Href="/app/admin/audit" Icon="RbiIconName.Gauge" Active="@IsActive("app/admin/audit")" /></RbiSidebarPart>
        }
        <RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["nav.profile"]" Href="/app/profile" Icon="RbiIconName.UserRound" Active="@IsActive("app/profile")" /></RbiSidebarPart>
        <AuthorizeView><Authorized><RbiSidebarPart Kind="RbiSidebarPartKind.MenuItem"><RbiSidebarItem Label="@T["guide.title"]" Href="/app/guide" Icon="RbiIconName.Gauge" Active="@IsActive("app/guide")" /></RbiSidebarPart></Authorized></AuthorizeView>
    </RbiSidebarPart>
</nav>

@code {
    private bool _physical, _legal, _limits, _capital, _admin, _reports;
    protected override async Task OnInitializedAsync()
    {
        if ((await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated != true) return;
        try { _admin = ApplicationAccess.IsAdministrator(await Profile.GetAsync()); _reports = await Permissions.HasPermissionAsync("reports.read"); _physical = await Permissions.HasPermissionAsync("fl.read"); _legal = await Permissions.HasPermissionAsync("pl.read"); _limits = await Permissions.HasPermissionAsync("limiti.read"); _capital = await Permissions.HasPermissionAsync("kapital.read"); }
        catch (RegistryApiException) { _physical = _legal = _limits = _capital = _admin = _reports = false; }
    }
    private bool IsActive(string path) => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') == path;
}
