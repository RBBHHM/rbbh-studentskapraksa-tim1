<header class="app-page-header">
    <div class="app-page-header__main">
        @if (Icon is { } icon) { <RbiIcon Name="icon" Class="app-page-header__icon" /> }
        <div class="app-page-header__title">
            @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <RbiEyebrow>@Eyebrow</RbiEyebrow> }
            <RbiHeading Level="1" VisualLevel="4" Class="@(string.IsNullOrWhiteSpace(Eyebrow) ? "app-page-header__heading app-page-header__heading--flush" : "app-page-header__heading")">@Title</RbiHeading>
            @if (!string.IsNullOrWhiteSpace(Description)) { <RbiText Tone="RbiTextTone.Secondary" Class="app-page-header__description">@Description</RbiText> }
        </div>
    </div>
    @if (Actions is not null) { <div class="app-page-header__actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    /// <summary>Small caps label above the title (the reference product shows the area on resource pages only).</summary>
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public RbiIconName? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
