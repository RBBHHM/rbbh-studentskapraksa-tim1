{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ],
    "Properties": {
      "Application": "RBBH.ConnectedParties"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Database": {
    "ApplyMigrations": false
  },
  "KeycloakSettings": {
    "Enabled": false,
    "Issuer": "",
    "PublicIssuer": "",
    "Audience": "connected-parties-api",
    "AdminClientId": "",
    "AdminClientSecret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Provider": "demo",
    "AdminEmail": "admin@raiffeisenbank.ba",
    "HrEmail": "hr@raiffeisenbank.ba",
    "AppBaseUrl": "http://localhost:5001",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "noreply@raiffeisenbank.ba",
      "FromName": "Raiffeisen Bank BiH"
    }
  }
}
