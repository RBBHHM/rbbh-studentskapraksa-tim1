<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	  <AssemblyName>Web.Blazor.BrowserHost</AssemblyName>
	  <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- The fixture references both hosts in one process and requires distinct assembly identities. -->
    <ProjectReference Include="../../Frontend/RBBH.RelatedPartiesRegister.Web.csproj"
                      AdditionalProperties="UseDistinctBrowserHostAssemblyName=true" />
    <ProjectReference Include="../../Backend/RelatedPartiesRegister.csproj" />
  </ItemGroup>
</Project>
