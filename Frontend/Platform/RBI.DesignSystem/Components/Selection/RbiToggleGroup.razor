@typeparam TValue
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div @ref="_root" @attributes="SafeAttributes" class="@CssClass" role="radiogroup" aria-label="@AccessibleLabel" aria-disabled="@(Disabled ? "true" : null)">
    <CascadingValue Value="@Context" IsFixed="false">@ChildContent</CascadingValue>
</div>

@code {
    private ElementReference _root;
    private Task<IJSObjectReference>? _moduleImport;
    private IJSObjectReference? _module;
    private readonly string _connectionId = Guid.NewGuid().ToString("N");
    private Task _operation = Task.CompletedTask;
    private Task? _disposal;
    private bool _connected;
    private bool _disposed;
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public string AccessibleLabel { get; set; } = string.Empty;
    [Parameter] public RbiToggleVariant Variant { get; set; } = RbiToggleVariant.Outline;
    [Parameter] public RbiToggleSize Size { get; set; } = RbiToggleSize.Medium;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private RbiToggleGroupContext<TValue> Context => new(Value, Disabled, SelectAsync);
    private string CssClass => string.Join(' ', new[] { "rbi-toggle-group", $"rbi-toggle-group--{Variant.ToString().ToLowerInvariant()}", $"rbi-toggle-group--{Size.ToString().ToLowerInvariant()}", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private IReadOnlyDictionary<string, object>? SafeAttributes => RBI.DesignSystem.Components.Forms.RbiFormUtilities.SafeAttributes(AdditionalAttributes, "class", "role", "aria-label", "aria-disabled");

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        _disposed ? Task.CompletedTask : _operation = SyncAsync(_operation);

    private async Task SyncAsync(Task previous)
    {
        await previous;
        if (_disposed) return;
        try
        {
            _moduleImport ??= JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/RBI.DesignSystem/js/rbi-toggle-group.js").AsTask();
            _module = await _moduleImport;
            if (_disposed) return;
            _connected = true;
            await _module.InvokeVoidAsync("connect", _root, _connectionId);
        }
        catch (JSDisconnectedException) when (_disposed) { }
    }

    ValueTask IAsyncDisposable.DisposeAsync() => new(_disposal ??= DisposeCoreAsync());

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        try { await _operation; }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_operation.IsCanceled) { }
        finally
        {
            try
            {
                if (_module is not null && _connected)
                {
                    try { await _module.InvokeVoidAsync("disconnect", _root, _connectionId); }
                    catch (JSDisconnectedException) { }
                }
            }
            finally
            {
                if (_module is not null)
                {
                    try { await _module.DisposeAsync(); }
                    catch (JSDisconnectedException) { }
                }
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(AccessibleLabel)) throw new InvalidOperationException($"{nameof(AccessibleLabel)} is required.");
    }

    private async Task SelectAsync(TValue value)
    {
        if (Disabled || EqualityComparer<TValue?>.Default.Equals(Value, value)) return;
        StateHasChanged();
        await ValueChanged.InvokeAsync(value);
    }
}
