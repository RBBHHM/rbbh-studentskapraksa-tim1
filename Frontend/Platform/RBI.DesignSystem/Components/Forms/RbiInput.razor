@inherits InputBase<string?>
@using Microsoft.AspNetCore.Components.Rendering

@InputControl

@code {
    private readonly string _generatedId = RbiFormUtilities.Id("input");
    private IReadOnlyDictionary<string, object>? _inputAttributes;
    private RenderFragment? _inputControl;

    [CascadingParameter] private RbiFieldContext? Field { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public RbiInputType Type { get; set; } = RbiInputType.Text;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Invalid { get; set; }
    /// <summary>Native event used for binding; Change remains the compatible default.</summary>
    [Parameter] public RbiInputUpdateMode UpdateMode { get; set; }

    private bool EffectiveDisabled => Disabled || Field?.Disabled == true;
    private bool EffectiveRequired => Required || Field?.Required == true;
    private bool ValidationInvalid => EditContext?.GetValidationMessages(FieldIdentifier).Any() == true;
    private bool EffectiveInvalid => Invalid || Field?.Invalid == true || ValidationInvalid;
    private string ResolvedId => Id ?? RbiFormUtilities.Attribute(AdditionalAttributes, "id") ?? Field?.ControlId ?? _generatedId;
    private string InputType => Type.ToString().ToLowerInvariant();
    private string ControlClass => string.Join(' ', new[] { "rbi-control", "rbi-input", CssClass, EffectiveInvalid ? "rbi-control--invalid" : null }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string? AriaInvalid => EffectiveInvalid ? "true" : RbiFormUtilities.Attribute(AdditionalAttributes, "aria-invalid");
    private string? DescribedBy => RbiFormUtilities.JoinIds(Field?.DescribedBy, RbiFormUtilities.Attribute(AdditionalAttributes, "aria-describedby"));
    private IReadOnlyDictionary<string, object>? SafeAttributes => _inputAttributes;

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(UpdateMode)) throw new ArgumentOutOfRangeException(nameof(UpdateMode));
        var safe = RbiFormUtilities.SafeAttributes(AdditionalAttributes, "id", "class", "type", "value", "placeholder", "disabled", "readonly", "required", "aria-invalid", "aria-describedby", "oninput", "onchange");
        _inputAttributes = safe;
    }

    private RenderFragment InputControl => _inputControl ??= BuildControl;
    private void BuildControl(RenderTreeBuilder builder)
    {
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, SafeAttributes);
        builder.AddAttribute(2, "id", ResolvedId);
        builder.AddAttribute(3, "class", ControlClass);
        builder.AddAttribute(4, "type", InputType);
        builder.AddAttribute(5, "value", CurrentValueAsString);
        builder.AddAttribute(6, "placeholder", Placeholder);
        builder.AddAttribute(7, "disabled", EffectiveDisabled);
        builder.AddAttribute(8, "readonly", ReadOnly);
        builder.AddAttribute(9, "required", EffectiveRequired);
        builder.AddAttribute(10, "aria-invalid", AriaInvalid);
        builder.AddAttribute(11, "aria-describedby", DescribedBy);
        builder.AddAttribute(12, UpdateMode == RbiInputUpdateMode.Input ? "oninput" : "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, ChangeValue));
        // Tell Blazor which DOM property the event changed, including rejected proposals.
        builder.SetUpdatesAttributeName("value");
        builder.CloseElement();
    }

    private void ChangeValue(ChangeEventArgs args)
    {
        if (EffectiveDisabled || ReadOnly) return;
        CurrentValueAsString = args.Value?.ToString();
    }
    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }
}
