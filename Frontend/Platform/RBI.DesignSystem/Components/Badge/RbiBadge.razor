<span @attributes="AdditionalAttributes" class="@CssClass">
    @if (WithDot)
    {
        <span class="rbi-badge__dot" aria-hidden="true"></span>
    }
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RbiBadgeTone Tone { get; set; } = RbiBadgeTone.Neutral;
    [Parameter] public RbiBadgeVariant Variant { get; set; } = RbiBadgeVariant.Subtle;
    [Parameter] public bool WithDot { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"rbi-badge rbi-badge--{Tone.ToString().ToLowerInvariant()} rbi-badge--{Variant.ToString().ToLowerInvariant()} {Class}".TrimEnd();
}
