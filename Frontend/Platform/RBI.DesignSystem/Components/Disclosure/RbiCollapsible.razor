<div @attributes="SafeAttributes" class="@CssClass">
    <button type="button"
            class="rbi-collapsible__trigger"
            disabled="@Disabled"
            aria-expanded="@(Expanded ? "true" : "false")"
            aria-controls="@_contentId"
            @onclick="ToggleAsync">
        @TriggerContent
        <span class="rbi-disclosure__chevron" aria-hidden="true">@RBI.DesignSystem.Components.RbiControlIcon.Render("down")</span>
    </button>
    <div id="@_contentId" class="rbi-collapsible__content" hidden="@(!Expanded)">
        @ChildContent
    </div>
</div>

@code {
    private readonly string _contentId = $"{RBI.DesignSystem.Components.Forms.RbiFormUtilities.Id("collapsible")}-content";

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[] { "rbi-collapsible", Expanded ? "rbi-collapsible--expanded" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private IReadOnlyDictionary<string, object>? SafeAttributes => RBI.DesignSystem.Components.Forms.RbiFormUtilities.SafeAttributes(AdditionalAttributes, "class");

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        await ExpandedChanged.InvokeAsync(!Expanded);
    }
}
