@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<span @ref="_root" class="rbi-anchored-overlay-host" data-rbi-popover-host>
    @TriggerContent
    <div @attributes="SafeAttributes"
         id="@_popoverId"
         class="@CssClass"
         role="dialog"
         aria-label="@AccessibleLabel"
         popover="auto"
         data-rbi-anchored-surface
         data-rbi-open="@EffectiveOpen.ToString().ToLowerInvariant()"
         data-rbi-preferred-placement="@PlacementValue">
        @PopoverContent
    </div>
</span>

@code {
    private readonly string _popoverId = RBI.DesignSystem.Components.Forms.RbiFormUtilities.Id("popover");
    private ElementReference _root;
    private RbiAnchoredOverlayInterop? _interop;
    private bool _disposed, _initialized, _nativeOpen, _lastParameterOpen;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string AccessibleLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment? TriggerContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment? PopoverContent { get; set; }
    [Parameter] public RbiOverlayPlacement Placement { get; set; } = RbiOverlayPlacement.Bottom;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string PlacementValue => Placement.ToString().ToLowerInvariant();
    private bool EffectiveOpen => OpenChanged.HasDelegate ? Open : _nativeOpen;
    private string CssClass => string.Join(' ', new[] { "rbi-anchored-surface", "rbi-popover", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private IReadOnlyDictionary<string, object>? SafeAttributes => RBI.DesignSystem.Components.Forms.RbiFormUtilities.SafeAttributes(AdditionalAttributes, "id", "class", "role", "popover", "aria-label", "aria-labelledby", "aria-describedby");

    protected override void OnParametersSet()
    {
        if (!_initialized || Open != _lastParameterOpen) _nativeOpen = Open;
        _lastParameterOpen = Open;
        _initialized = true;
        if (string.IsNullOrWhiteSpace(AccessibleLabel)) throw new InvalidOperationException($"{nameof(AccessibleLabel)} is required.");
        if (TriggerContent is null) throw new InvalidOperationException($"{nameof(TriggerContent)} is required.");
        if (PopoverContent is null) throw new InvalidOperationException($"{nameof(PopoverContent)} is required.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        _interop ??= new RbiAnchoredOverlayInterop(JavaScript);
        await _interop.SyncPopoverAsync(_root, this, EffectiveOpen, Placement);
    }

    [JSInvokable]
    public async Task NativeOpenChanged(bool open)
    {
        if (_disposed || EffectiveOpen == open) return;
        if (!OpenChanged.HasDelegate) _nativeOpen = open;
        await OpenChanged.InvokeAsync(open);
        if (!_disposed) StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_interop is not null) await _interop.DisposeAsync();
    }
}
