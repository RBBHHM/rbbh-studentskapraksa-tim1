@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@using RBI.DesignSystem.Components.Forms
@using RBI.DesignSystem.Components.Overlay

<span @ref="_root" class="rbi-anchored-overlay-host" data-rbi-menu-host>
    @TargetContent
    <CascadingValue Value="_context" IsFixed="true">
        <div @attributes="SafeAttributes"
             id="@_menuId"
             class="@CssClass"
             role="menu"
             aria-label="@AccessibleLabel"
             popover="auto"
             data-rbi-anchored-surface
             data-rbi-menu-loop="@(Loop ? "true" : null)"
             data-rbi-open="@EffectiveOpen.ToString().ToLowerInvariant()"
             data-rbi-preferred-placement="@PlacementValue">
            @MenuContent
        </div>
    </CascadingValue>
</span>

@code {
    private readonly string _menuId = RbiFormUtilities.Id("context-menu");
    private readonly RbiMenuContext _context;
    private ElementReference _root;
    private RbiAnchoredOverlayInterop? _interop;
    private string? _pendingFocus;
    private bool _previousOpen;
    private bool _nativeOpen, _lastParameterOpen, _initialized, _disposed;
    private bool EffectiveOpen => !_disposed && (OpenChanged.HasDelegate ? Open : _nativeOpen);

    public RbiContextMenu() => _context = new RbiMenuContext(CloseFromMenuAsync, () => EffectiveOpen);

    [Parameter] public bool Open { get; set; }
    /// <summary>Wraps arrow-key focus from the last item to the first and back; false (the Radix default) stops at the ends.</summary>
    [Parameter] public bool Loop { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string AccessibleLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment? TargetContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment? MenuContent { get; set; }
    [Parameter] public RbiOverlayPlacement Placement { get; set; } = RbiOverlayPlacement.Right;
    /// <summary>Cross-axis alignment with the pointer point; the Legacy context menu starts at the pointer.</summary>
    [Parameter] public RbiMenuAlignment Align { get; set; } = RbiMenuAlignment.Start;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string PlacementValue => Placement.ToString().ToLowerInvariant();
    private string CssClass => string.Join(' ', new[] { "rbi-anchored-surface", "rbi-menu", "rbi-context-menu", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private IReadOnlyDictionary<string, object>? SafeAttributes => RbiFormUtilities.SafeAttributes(AdditionalAttributes, "id", "class", "role", "popover", "aria-label", "aria-labelledby");

    protected override void OnParametersSet()
    {
        if (!_initialized || Open != _lastParameterOpen) _nativeOpen = Open;
        _lastParameterOpen = Open;
        _initialized = true;
        if (string.IsNullOrWhiteSpace(AccessibleLabel)) throw new InvalidOperationException($"{nameof(AccessibleLabel)} is required.");
        if (TargetContent is null) throw new InvalidOperationException($"{nameof(TargetContent)} is required.");
        if (MenuContent is null) throw new InvalidOperationException($"{nameof(MenuContent)} is required.");
        if (EffectiveOpen && !_previousOpen) _pendingFocus ??= "first";
        _previousOpen = EffectiveOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        _interop ??= new RbiAnchoredOverlayInterop(JavaScript);
        await _interop.SyncMenuAsync(_root, this, EffectiveOpen, Placement, "context", Align);
        if (EffectiveOpen && _pendingFocus is not null)
        {
            var target = _pendingFocus;
            _pendingFocus = null;
            await _interop.FocusMenuAsync(target);
        }
    }

    [JSInvokable]
    public async Task NativeOpenChanged(bool open, string focusTarget)
    {
        if (_disposed) return;
        if (open) _pendingFocus = focusTarget is "last" ? "last" : "first";
        if (EffectiveOpen == open)
        {
            if (open) StateHasChanged();
            return;
        }
        _previousOpen = open;
        if (!OpenChanged.HasDelegate) _nativeOpen = open;
        await OpenChanged.InvokeAsync(open);
        StateHasChanged();
    }

    private Task CloseFromMenuAsync(bool restoreFocus) => SetOpenAsync(false);

    private async Task SetOpenAsync(bool open)
    {
        if (_disposed) return;
        if (EffectiveOpen == open) return;
        _previousOpen = open;
        if (!OpenChanged.HasDelegate) _nativeOpen = open;
        await OpenChanged.InvokeAsync(open);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_interop is not null) await _interop.DisposeAsync();
    }
}
