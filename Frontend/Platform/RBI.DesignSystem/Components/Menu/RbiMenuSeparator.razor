@using RBI.DesignSystem.Components.Forms

<div @attributes="SafeAttributes" class="@CssClass" role="separator"></div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string CssClass => string.Join(' ', new[] { "rbi-menu-separator", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private IReadOnlyDictionary<string, object>? SafeAttributes => RbiFormUtilities.SafeAttributes(AdditionalAttributes, "class", "role");
}
