@page "/app/notifications"
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject INotificationsApi Api
@inject RuntimeResources Runtime
@inject NotificationState State

<PageTitle>@T["notifications.title"]</PageTitle>
<HeroBar Title="@T["notifications.title"]" Description="@T["notifications.subtitle"]" Eyebrow="@T["nav.area.work"]">
</HeroBar>
@if (!_authenticated && !_loading) { <IdentityNotice /> }
else if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (_error is not null)
{
    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else
{
    <div class="registry-controls notification-filter" role="group" aria-label="@T["notifications.filter"]">
        <RbiButton Variant="@(_unreadOnly ? RbiButtonVariant.Secondary : RbiButtonVariant.Primary)" aria-pressed="@(_unreadOnly ? "false" : "true")" OnClick="() => FilterAsync(false)">@T["notifications.filter-all"]</RbiButton>
        <RbiButton Variant="@(_unreadOnly ? RbiButtonVariant.Primary : RbiButtonVariant.Secondary)" aria-pressed="@(_unreadOnly ? "true" : "false")" OnClick="() => FilterAsync(true)">@T.Format("notifications.filter-unread", _page.UnreadCount)</RbiButton>
    </div>
    @if (_page.Items.Count == 0) { <div class="registry-surface"><RegistryEmpty Body="@T[_unreadOnly ? "notifications.empty-unread" : "notifications.empty"]" /></div> }
    else
    {
        <ul class="notification-list" aria-label="@T["notifications.title"]">
            @foreach (var item in _page.Items)
            {
                <li @key="item.Id" class="notification" data-unread="@(item.IsUnread ? "true" : "false")">
                    <div class="notification__text">
                        <h2 class="notification__title">@(item.IsUnread ? T["notifications.new"] + " · " : "")@T.Resolve(item.TitleKey, item.Parameters)</h2>
                        <p class="notification__body">@T.Resolve(item.BodyKey, item.Parameters)</p>
                        <time class="notification__time" datetime="@item.CreatedAt.ToString("O")">@AppFormat.Timestamp(item.CreatedAt)</time>
                    </div>
                    <div class="notification__actions">
                        @if (SafeRoute(item.Route) is { } route) { <a class="rbi-button rbi-button--secondary rbi-button--medium" href="@route">@T["notifications.open"]</a> }
                        @if (item.IsUnread) { <RbiButton Variant="RbiButtonVariant.Ghost" Disabled="_busy" OnClick="() => MarkReadAsync(item)">@T["notifications.mark-read"]</RbiButton> }
                    </div>
                </li>
            }
        </ul>
    }
    <p class="page-total" role="status">@T.Format("legal.page-summary", _pageNumber, TotalPages, _page.Total)</p>
    <RbiPagination CurrentPage="_pageNumber" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["notifications.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("legal.page", page))" />
}
@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public Notifications() => _token = _lifetime.Token;
    private InboxPage _page = new([], 0, 1, 20, 0);
    private string? _error;
    private int _pageNumber = 1;
    private bool _disposed, _authenticated, _loading = true, _refreshing, _busy, _unreadOnly;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_page.Total / (double)Math.Max(1, _page.PageSize)));
    protected override Task OnInitializedAsync() => LoadAsync();
    // Only same-application relative paths are linked.
    private static string? SafeRoute(string? route) => route is { Length: > 0 } && route[0] == '/' && !route.StartsWith("//", StringComparison.Ordinal) && !route.Contains('\\') ? route : null;
    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            await Runtime.EnsureAsync(_token);
            _page = await Api.InboxAsync(_pageNumber, 20, _unreadOnly, _token);
            if (_pageNumber > TotalPages) { _pageNumber = TotalPages; _page = await Api.InboxAsync(_pageNumber, 20, _unreadOnly, _token); }
            State.Set(_page.UnreadCount);
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; _refreshing = false; }
    }
    private async Task FilterAsync(bool unreadOnly) { if (_unreadOnly == unreadOnly) return; _unreadOnly = unreadOnly; _pageNumber = 1; await LoadAsync(); }
    private async Task ChangePageAsync(int page) { if (_refreshing || page < 1 || page > TotalPages) return; _pageNumber = page; await LoadAsync(); }
    private async Task MarkReadAsync(InboxNotification item)
    {
        if (_busy) return; _busy = true;
        try { await Api.MarkReadAsync(item.Id, _token); await LoadAsync(); }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
