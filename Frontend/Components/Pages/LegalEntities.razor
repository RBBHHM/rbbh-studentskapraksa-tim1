@page "/app/legal-persons"
@using RBBH.RelatedPartiesRegister.Web.Components.Registry
@using RBI.DesignSystem.Components.Forms
@using Microsoft.JSInterop
@implements IDisposable
@inject RuntimeResources Runtime
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject ILegalEntitiesApi Api
@inject IPeriodApi Period
@inject IRelatedPersonsApi References
@inject FileDelivery Files

<PageTitle>@T["legal.title"]</PageTitle>
<HeroBar Title="@T["legal.title"]" Description="@T["legal.subtitle"]" Eyebrow="@T["nav.area.work"]">
    <Actions>
        @if (_authenticated && _canRead && !_loading && _error is null)
        {

            @if (_canCreate) { <label class="registry-file-button registry-file-button--secondary"><RbiIcon Name="RbiIconName.FileUp" /><span>@T["common.import"]</span><InputFile @key="_fileKey" id="legal-import" accept=".xlsx" OnChange="ChooseImport" disabled="@(_busy || _openingEditor || _refreshing || _periodLocked)" /></label> }
            <RbiButton Disabled="@(_busy || _openingEditor || _refreshing)" OnClick="ExportAsync" Variant="RbiButtonVariant.Secondary"><RbiIcon Name="RbiIconName.Download" />@T["common.export"]</RbiButton>
            @if (_canCreate) { <RbiButton Disabled="@(_busy || _refreshing || _periodLocked)" Loading="_openingEditor" LoadingLabel="@T["state.loading"]" OnClick="() => Edit(null)"><RbiIcon Name="RbiIconName.Plus" />@T["common.new"]</RbiButton> }
        }
    </Actions>
</HeroBar>
@if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (_error is not null)
{
    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" Announcement="RbiAlertAnnouncement.Assertive" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else if (!_canRead) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    @if ((_canCreate || _canEdit || _canDelete) && _periodLocked) { <RbiAlert Title="@T[_periodError ?? "errors.locked"]" /> }
    @if (!_delete && _action is null && _actionError is not null) { <div role="alert" class="app-toast app-toast--danger"><RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_actionError]" /></div> }
    @if (_notice is not null) { <div role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@T.Format(_notice, _noticeCount)" /></div> }
    <div class="registry-controls"><RegistrySearch Id="legal-search" Label="@T["legal.search"]" @bind-Value="_search" @bind-Value:after="SearchAsync" /></div>
    @if (_entities.Count == 0) { <div class="registry-surface"><RegistryEmpty Body="@T[string.IsNullOrWhiteSpace(_search) ? "state.empty-body" : "state.no-match"]" /></div> }
    else
    {
        <RbiTable AccessibleLabel="@T["legal.title"]" Class="registry-table registry-persons-table">
                        <thead><tr><th scope="col">@T["legal.name"]</th><th scope="col" class="registry-center">@T["person.residency"]</th><th scope="col">@T["legal.tax"]</th><th scope="col">@T["legal.registration"]</th><th scope="col">@T["person.fba"]</th><th scope="col">@T["legal.gcc"]</th><th scope="col" class="registry-center">@T["legal.large-exposure"]</th><th scope="col">@T["person.basis"]</th><th scope="col" class="registry-center">@T["common.status"]</th>@if (_canEdit || _canDelete) { <th scope="col" class="registry-center registry-actions-cell">@T["common.actions"]</th> }</tr></thead>
            <tbody>@foreach (var entity in _entities)
            {
                <tr @key="entity.Id"><td>@entity.Name</td><td class="registry-center"><Indicator Kind="@(entity.IsResident ? "yes" : "no")" Label="@T[entity.IsResident ? "person.resident" : "person.nonresident"]" /></td><td>@Dash(entity.TaxNumber)</td><td>@Dash(entity.MaticniBroj)</td><td>@Dash(entity.FbaId)</td><td>@Dash(entity.GccNumber is { Length: > 0 } ? $"{entity.GccNumber} — {entity.GccName}" : null)</td><td class="registry-center">@(entity.IsLargeExposure is { } large ? (large ? T["common.yes"] : T["common.no"]) : "—")</td><td>@Dash(entity.BasisOfConnection)</td><td class="registry-center"><Indicator Kind="@entity.Status.ToLowerInvariant()" Label="@T[$"status.{entity.Status.ToLowerInvariant()}"]" /></td>
                    @if (_canEdit || _canDelete)
                    {
                        <td class="registry-actions-cell"><div class="registry-row-actions">
                            @if (_canEdit)
                            {
                                @if (!string.Equals(entity.Status, "Verified", StringComparison.OrdinalIgnoreCase)) { <span title="@T[Own(entity.CreatedBy) ? "common.verify-own" : "common.verify"]"><RbiButton Disabled="@(_busy || _openingEditor || _refreshing || _periodLocked)" OnClick="() => Confirm(entity, false)" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["common.verify"]"><RbiIcon Name="RbiIconName.CheckCircle2" /></RbiButton></span> }
                                <RbiButton Disabled="@(_busy || _refreshing || _periodLocked)" Loading="_openingEditor" LoadingLabel="@T["state.loading"]" OnClick="() => Edit(entity)" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["common.edit"]" title="@T["common.edit"]"><RbiIcon Name="RbiIconName.Pencil" /></RbiButton>
                            }
                            @if (_canDelete) { <RbiButton Disabled="@(_busy || _openingEditor || _refreshing || _periodLocked)" OnClick="() => Confirm(entity, true)" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["common.deactivate"]" title="@T["common.deactivate"]" Class="registry-danger-icon"><RbiIcon Name="RbiIconName.Trash2" /></RbiButton> }
                        </div></td>
                    }
                </tr>
            }</tbody>
        </RbiTable>
    }
    @if (TotalPages > 1)
    {
        <p class="page-total" role="status">@T.Format("legal.page-summary", _page, TotalPages, _total)</p>
    <RbiPagination CurrentPage="_page" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["legal.pages"]"
                   PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("legal.page", page))" />
    }
}
@if (_draft is { } draft)
{
    <RbiDialog Open Class="app-form-dialog" Title="@T[_editingId.HasValue ? "common.edit" : "common.new"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseEditor">
        <DialogBody>
            @if (_fallback) { <RbiAlert Title="@T["legal.bases-unavailable"]" /> }
            <LegalEntityForm MutationBlocked="_periodLocked" @key="draft" Model="draft" Bases="_bases" Save="SaveAsync" Cancel="() => CloseEditor(false)" />
        </DialogBody>
    </RbiDialog>
}
<RbiAlertDialog Open="@(_action is not null && _delete)" OpenChanged="CloseAction" Title="@T[_delete ? "legal.delete-title" : "legal.verify-title"]"
                Description="@T[_delete ? "legal.delete-description" : "legal.verify-description"]" CancelLabel="@T["common.cancel"]" ConfirmLabel="@T["common.delete"]"
                ConfirmLoadingLabel="@T["common.saving"]" Confirming="_busy" OnConfirm="RunActionAsync">
    @if (_actionError is not null) { <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_actionError]" /> }
</RbiAlertDialog>
<RbiDialog Open="@(_importResult is not null || _importError is not null)" OpenChanged="CloseImport" Class="app-result-dialog" Title="@T["import.result-title"]" Description="@(_importResult is { } summary ? T.Format("import.result", summary.Imported, summary.Failed) : null)" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)">
    <DialogBody>
        @if (_importError is not null) { <div class="app-result app-result--danger" role="alert">@T[_importError]</div> }
        else if (_importResult is { } result)
        {
            @if (result.Errors.Count > 0)
            {
                <div class="app-result app-result--danger" role="status"><p><strong>@T["import.fix-title"]</strong></p><ol>@foreach (var error in result.Errors) { <li>@SafeImportError(error)</li> }</ol></div>
            }
            else { <div class="app-result app-result--success" role="status">@T["import.success"]</div> }
        }
    </DialogBody>
    <DialogFooter><RbiButton OnClick="() => CloseImport(false)" Disabled="_busy">@T["common.close"]</RbiButton></DialogFooter>
</RbiDialog>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public LegalEntities() => _token = _lifetime.Token;
    private IReadOnlyList<LegalEntity> _entities = [];
    private IReadOnlyList<ReferenceOption> _bases = [];
    private LegalEntityDraft? _draft;
    private long? _editingId;
    private LegalEntity? _action;
    private IBrowserFile? _importFile;
    private Guid _fileKey = Guid.NewGuid();
    private ImportResult? _importResult;
    private int _noticeCount;
    private string? _search, _error, _notice, _actionError, _importError;
    private string? _periodError;
    private bool _periodLocked = true;
    private int _page = 1, _total, _pageSize = 20;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
    private bool _disposed, _authenticated, _loading = true, _busy, _canRead, _canCreate, _canEdit, _canDelete, _delete, _importOpen, _fallback;
    private bool _loaded, _refreshing, _openingEditor;
    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private string? _self;
    // Four-eyes: the person who entered a record cannot verify it (the backend remains authoritative).
    private bool Own(string? createdBy) => !string.IsNullOrWhiteSpace(_self) && string.Equals(createdBy?.Trim(), _self.Trim(), StringComparison.OrdinalIgnoreCase);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_disposed) return;
        _loading = !_loaded; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token); _self = profile.Username;
            _canRead = profile.Permissions.Contains("PL_VIEW"); _canCreate = profile.Permissions.Contains("PL_CREATE");
            _canEdit = profile.Permissions.Contains("PL_EDIT"); _canDelete = profile.Permissions.Contains("PL_DELETE");
            if (!_canRead) return;
            try { _periodLocked = (await Period.CurrentAsync(_token)).IsLocked; _periodError = null; }
            catch (RegistryApiException) { _periodLocked = true; _periodError = "period.state-unavailable"; }
            await LoadPageAsync(_page);
            _loaded = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        finally { _loading = false; _refreshing = false; }
    }
    private readonly LatestPageRequest _pageRequest = new();

    private Task SearchAsync() => LoadPageAsync(1, debounce: true);
    private Task ChangePageAsync(int page) => LoadPageAsync(page);

    private async Task LoadPageAsync(int page, bool debounce = false)
    {
        if (_disposed) return;
        var search = _search;
        _refreshing = true;
        await _pageRequest.RunAsync(_token, debounce, async token =>
        {
            var result = await Api.ListAsync(page, token, search);
            var lastPage = Math.Max(1, (int)Math.Ceiling(result.Total / (double)Math.Max(1, result.PageSize)));
            if (page > lastPage) result = await Api.ListAsync(lastPage, token, search);
            token.ThrowIfCancellationRequested();
            _entities = result.Items; _total = result.Total; _pageSize = result.PageSize;
            _page = result.Page;
            _error = null;
        }, exception => _error = exception.MessageKey, () => _refreshing = false);
    }
    private async Task Edit(LegalEntity? entity)
    {
        if (_periodLocked || _busy || _openingEditor || _refreshing || _disposed || !_authenticated || (entity is null ? !_canCreate : !_canEdit)) return;
        _openingEditor = true;
        try
        {
            // Fetch the current detail to preserve server-only Matbroj on update.
            if (entity is not null) entity = await Api.GetAsync(entity.Id, _token);
            _editingId = entity?.Id;
            _bases = [];
            _fallback = false;
            try
            {
                var bases = await References.OptionsAsync("OSNOV_POVEZANOSTI", _token);
                _fallback = bases.Count == 0;
                _bases = bases.Select(LocalizeBasis).ToArray();
            }
            catch (RegistryApiException) { _fallback = true; }
            if (entity is not null && !_bases.Any(option => option.Kod == entity.BasisOfConnection))
                _bases = [.. _bases, new(entity.BasisOfConnection, entity.BasisOfConnection, entity.ConnectionDescription)];
            _draft = entity is null ? new() : LegalEntityDraft.From(entity);
            if (entity is not null && _bases.FirstOrDefault(option => option.Kod == entity.BasisOfConnection) is { } selected)
                _draft.ConnectionDescription = selected.Opis;
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _openingEditor = false; }
    }
    private ReferenceOption LocalizeBasis(ReferenceOption option)
    {
        if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bs") return option;
        var key = "legal.basis." + option.Kod.ToLowerInvariant();
        return Runtime.TryGet(key, out var label)
            ? option with { Naziv = label, Opis = Runtime.Helper(key) ?? option.Opis }
            : option;
    }

    private void CloseEditor(bool open) { if (!open && !_busy) _draft = null; }
    private async Task SaveAsync(LegalEntityRequest request)
    {
        if (!_authenticated || (_editingId.HasValue ? !_canEdit : !_canCreate)) throw new RegistryApiException(System.Net.HttpStatusCode.Forbidden);
        if (_periodLocked) throw new RegistryApiException((System.Net.HttpStatusCode)423);
        if (_busy) return; _busy = true;
        try { await Api.SaveAsync(_editingId, request, _token); _notice = "toast.saved"; await LoadAsync(); }
        catch (RegistryApiException exception) when ((int?)exception.StatusCode == 423) { _periodLocked = true; await InvokeAsync(StateHasChanged); throw; }
        finally { _busy = false; }
        _draft = null;
    }
    private async Task Confirm(LegalEntity entity, bool delete)
    {
        if (!_authenticated || _periodLocked || (delete ? !_canDelete : !_canEdit) || _openingEditor || _refreshing || _busy) return;
        _delete = delete;
        if (!delete && Own(entity.CreatedBy))
        {
            _action = null;
            _actionError = "common.verify-own";
            return;
        }

        _action = entity;
        _actionError = null;
        if (!delete) await RunActionAsync();
    }
    private void CloseAction(bool open) { if (!open && !_busy) _action = null; }
    private async Task RunActionAsync()
    {
        if (!_authenticated || (_delete ? !_canDelete : !_canEdit) || _busy || _action is null) return;
        if (_periodLocked) { _actionError = "errors.locked"; return; }
        _busy = true;
        try { if (_delete) await Api.DeleteAsync(_action.Id, _token); else await Api.VerifyAsync(_action.Id, _token); _notice = _delete ? "toast.deleted" : "toast.verified"; _action = null; await LoadAsync(); }
        catch (RegistryApiException exception) { if ((int?)exception.StatusCode == 423) _periodLocked = true; _actionError = exception.MessageKey; if (!_delete) _action = null; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private async Task ExportAsync()
    {
        if (!_authenticated || !_canRead || _busy) return; _busy = true;
        try { await Files.DownloadAsync(await Api.ExportAsync(_token), _token); }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private void CloseImport(bool open) { if (!_busy) { _importOpen = open; if (!open) { _importFile = null; _importResult = null; _importError = null; _fileKey = Guid.NewGuid(); } } }
    private async Task ChooseImport(InputFileChangeEventArgs args)
    {
        _importFile = null; _importResult = null; _importError = null;
        if (!_authenticated || !_canCreate) { _importError = "errors.forbidden"; return; }
        var file = args.File;
        if (file.Size is <= 0 or > 10485760 || !file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)) { _importError = "import.invalid-file"; return; }
        _importFile = file;
        await ImportAsync();
    }
    private async Task ImportAsync()
    {
        if (!_authenticated || !_canCreate) { _importError = "errors.forbidden"; return; }
        if (_periodLocked) { _importError = "errors.locked"; return; }
        if (_busy || _importFile is null) return; _busy = true; _importError = null;
        try
        {
            await using var stream = _importFile.OpenReadStream(10485760, _token);
            _importResult = await Api.ImportAsync(stream, _importFile.Name, _token); if (_importResult.Failed == 0) { _notice = "toast.import"; _noticeCount = _importResult.Imported; } _importFile = null; await LoadAsync();
        }
        catch (RegistryApiException exception) { _importError = exception.StatusCode == System.Net.HttpStatusCode.BadRequest ? "import.invalid-workbook" : exception.MessageKey; }
        catch (IOException) { _importError = "import.invalid-file"; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private string SafeImportError(string error)
    {
        string[] columns = ["legal.name", "person.residency", "legal.tax", "person.fba", "legal.registration", "person.basis", "person.description", "person.connected-bank", "person.from", "person.to"];
        return ImportFeedback.Format(error, T, columns);
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
