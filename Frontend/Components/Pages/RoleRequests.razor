@page "/app/admin/role-requests"
@using RBBH.RelatedPartiesRegister.Web.Security
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IRoleRequestsApi Api

<PageTitle>@T["roles.admin-title"]</PageTitle>
<HeroBar Title="@T["roles.admin-title"]" Description="@T["roles.admin-subtitle"]" Eyebrow="@T["nav.area.administration"]">
</HeroBar>
@if (!_authenticated && !_loading) { <IdentityNotice /> }
else if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (_error is not null)
{
    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else if (!_canManage) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    @if (_notice is not null) { <div role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@T[_notice]" /></div> }
    <div class="registry-controls notification-filter" role="group" aria-label="@T["roles.filter"]">
        @foreach (var status in Enum.GetValues<StatusFilter>())
        {
            <RbiButton @key="status" Variant="@(_filter == status ? RbiButtonVariant.Primary : RbiButtonVariant.Secondary)" aria-pressed="@(_filter == status ? "true" : "false")" OnClick="() => FilterAsync(status)">@T["roles.status." + status.ToString().ToLowerInvariant()]</RbiButton>
        }
    </div>
    @if (_page.Items.Count == 0) { <div class="registry-surface"><RegistryEmpty Body="@T["roles.empty"]" /></div> }
    else
    {
        <RbiTable AccessibleLabel="@T["roles.admin-title"]" Class="registry-table">
            <thead><tr><th scope="col">@T["roles.col-requester"]</th><th scope="col">@T["roles.col-type"]</th><th scope="col">@T["roles.col-roles"]</th><th scope="col">@T["roles.col-note"]</th><th scope="col">@T["roles.col-status"]</th><th scope="col">@T["roles.col-created"]</th><th scope="col">@T["common.actions"]</th></tr></thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr @key="item.Id">
                    <td>@(item.RequesterUsername ?? "—")<br /><span class="app-hint">@item.RequesterEmail</span></td>
                    <td>@T["roles.purpose." + item.Purpose]</td>
                    <td>@RoleNames(item.RoleNames)</td>
                    <td>@(item.Note ?? "—")@if (item.DecisionNote is { Length: > 0 }) { <br /><span class="app-hint">@item.DecisionNote</span> }</td>
                    <td>@T["roles.status." + item.Status]</td>
                    <td>@AppFormat.Timestamp(item.CreatedAt)</td>
                    <td>
                        @if (item.Status == "pending")
                        {
                            <RbiButton Disabled="_busy" OnClick="() => Decide(item, true)">@T["roles.approve"]</RbiButton>
                            <RbiButton Disabled="_busy" Variant="RbiButtonVariant.Secondary" OnClick="() => Decide(item, false)">@T["roles.reject"]</RbiButton>
                        }
                        else { <span class="app-hint">@item.ProcessedBy</span> }
                    </td>
                </tr>
            }
            </tbody>
        </RbiTable>
    }
    <p class="page-total" role="status">@T.Format("legal.page-summary", _pageNumber, TotalPages, _page.Total)</p>
    <RbiPagination CurrentPage="_pageNumber" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["roles.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("legal.page", page))" />
}
@if (_target is { } target)
{
    <RbiDialog Open Class="registry-period-dialog" Title="@T[_approve ? "roles.approve-title" : "roles.reject-title"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="value => { if (!value && !_busy) _target = null; }">
        <DialogBody>
            <form class="registry-period-form" @onsubmit="ConfirmAsync" @onsubmit:preventDefault novalidate>
                <p class="registry-period-dialog__help">@T.Format(_approve ? "roles.approve-help" : "roles.reject-help", target.RequesterUsername ?? "", RoleNames(target.RoleNames))</p>
                <label class="app-label" for="role-decision-note">@T["roles.decision-note"]</label>
                <textarea id="role-decision-note" class="rbi-textarea" rows="3" maxlength="1000" @bind="_decisionNote" @bind:event="oninput"></textarea>
                @if (_decisionError is not null) { <p class="app-error" role="alert">@T[_decisionError]</p> }
                <div class="registry-toolbar">
                    <RbiButton OnClick="() => _target = null" Variant="RbiButtonVariant.Secondary" Disabled="_busy">@T["common.cancel"]</RbiButton>
                    <RbiButton Type="RbiButtonType.Submit" Disabled="_busy">@T[_approve ? "roles.approve" : "roles.reject"]</RbiButton>
                </div>
            </form>
        </DialogBody>
    </RbiDialog>
}
@code {
    // Workflow states are server-owned invariants (pending, approved, rejected), not business dropdown values.
    private enum StatusFilter { Pending, Approved, Rejected, All }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public RoleRequests() => _token = _lifetime.Token;
    private RoleRequestsPage _page = new([], 0, 1, 20);
    private RoleRequest? _target;
    private StatusFilter _filter = StatusFilter.Pending;
    private string _decisionNote = "";
    private string? _error, _notice, _decisionError;
    private int _pageNumber = 1;
    private bool _disposed, _authenticated, _canManage, _loading = true, _refreshing, _busy, _approve;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_page.Total / (double)Math.Max(1, _page.PageSize)));
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token);
            _canManage = ApplicationAccess.IsAdministrator(profile) && profile.Permissions.Contains("ADMINISTRATION_MANAGE");
            if (!_canManage) return;
            _page = await Api.ReviewAsync(_pageNumber, _filter == StatusFilter.All ? "" : _filter.ToString().ToLowerInvariant(), _token);
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; _refreshing = false; }
    }
    private string RoleNames(IEnumerable<string> names) => string.Join(", ", names.Select(name => T.Role(name)));
    private async Task FilterAsync(StatusFilter status) { if (_filter == status) return; _filter = status; _pageNumber = 1; await LoadAsync(); }
    private async Task ChangePageAsync(int page) { if (_refreshing || page < 1 || page > TotalPages) return; _pageNumber = page; await LoadAsync(); }
    private void Decide(RoleRequest item, bool approve) { _target = item; _approve = approve; _decisionNote = ""; _decisionError = null; }
    private async Task ConfirmAsync()
    {
        if (_busy || _target is not { } target) return; _busy = true; _decisionError = null;
        try
        {
            await Api.DecideAsync(target, _approve, string.IsNullOrWhiteSpace(_decisionNote) ? null : _decisionNote.Trim(), _token);
            _notice = _approve ? "roles.approved-toast" : "roles.rejected-toast"; _target = null; await LoadAsync();
        }
        catch (RegistryApiException exception) { _decisionError = exception.MessageKey; if ((int?)exception.StatusCode == 409) await LoadAsync(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
