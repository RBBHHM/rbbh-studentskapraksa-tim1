@page "/app/admin/code-lists"
@using RBI.DesignSystem.Components.Forms
@using RBBH.RelatedPartiesRegister.Web.Components.Registry
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject ICodeListsApi Api
@inject ILocalizationApi Localization
@inject RuntimeResources Runtime
@inject FileDelivery Files

<PageTitle>@T["codes.title"]</PageTitle>
<HeroBar Title="@T["codes.title"]" Description="@T["codes.subtitle"]">
    <Actions>
        @if (_authenticated && _canRead && !_loading)
        {

            @if (_canWrite)
            {
                <RbiButton Disabled="@(_busy || _refreshing)" OnClick="NewDefinition" Variant="RbiButtonVariant.Secondary"><RbiIcon Name="RbiIconName.Plus" />@T["codes.definition-create"]</RbiButton>
                @if (_category.Length > 0)
                {
                    <RbiButton Disabled="@(_busy || _refreshing || CategoryInactive)" OnClick="DownloadTemplateAsync" Variant="RbiButtonVariant.Secondary"><RbiIcon Name="RbiIconName.Download" />@T["codes.csv.template"]</RbiButton>
                    <label class="registry-file-button"><RbiIcon Name="RbiIconName.FileUp" /><span>@T["codes.csv.import"]</span><InputFile @key="_fileKey" id="code-file" aria-label="@T["codes.csv.import"]" accept=".csv,text/csv" OnChange="PreviewAsync" disabled="@(_busy || _refreshing || CategoryInactive)" /></label>
                }
                <RbiButton Disabled="@(_busy || _refreshing || _category.Length == 0 || CategoryInactive)" OnClick="NewValue"><RbiIcon Name="RbiIconName.Plus" />@T["codes.create"]</RbiButton>
            }
        }
    </Actions>
</HeroBar>
@if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (!_canRead && _error is null) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    @if (_error is not null) { <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" /><RbiButton Disabled="_busy" OnClick="LoadAsync">@T["state.retry"]</RbiButton> }
    @if (_canRead)
    {
        @if (_toastError is not null) { <div role="alert" class="app-toast app-toast--danger"><RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_toastError]" /></div> }
        @if (_notice is not null) { <div role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@_notice" /></div> }
        @if (_category.Length == 0)
        {
            <div class="registry-controls"><RegistrySearch Id="code-search" Label="@T["codes.search"]" @bind-Value="_search" @bind-Value:after="SearchDefinitionsAsync" /></div>
            @if (_overview.Items.Count == 0)
            {
                <div class="registry-surface"><RegistryEmpty Body="@T[string.IsNullOrWhiteSpace(_search) ? "codes.no-categories" : "state.no-match"]" /></div>
            }
            else
            {
                <ul class="codes-cards" aria-label="@T["codes.title"]">
                    @foreach (var item in _overview.Items)
                    {
                        <li @key="item.Id">
                            <button type="button" class="codes-card" aria-label="@item.Name" aria-describedby="@($"codebook-status-{item.Id}")"
                                    disabled="@(_busy || _refreshing)" @onclick="() => OpenCategoryAsync(item.Name)">
                                <AppIcon Name="AppIconName.BookOpen" /><span class="codes-card__name">@item.Name</span>
                                <span id="@($"codebook-status-{item.Id}")" class="codebook-status @(item.IsActive ? "codebook-status--active" : "codebook-status--inactive")">
                                    <span class="app-visually-hidden">@T[item.IsActive ? "codes.active" : "codes.inactive"]</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                @if (DefinitionPages > 1)
                {
                    <p class="page-total" role="status">@T.Format("legal.page-summary", _overview.Page, DefinitionPages, _overview.Total)</p>
                    <RbiPagination CurrentPage="_overview.Page" CurrentPageChanged="LoadDefinitionsPageAsync" TotalPages="DefinitionPages"
                                   AccessibleLabel="@T["codes.title"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]"
                                   NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]"
                                   PageAccessibleLabel="@(number => T.Format("legal.page", number))" />
                }
            }
        }
        else
        {
            <header class="codebook-detail">
                <h2 class="codebook-detail__title">@_category</h2>
                @if (CategoryInactive)
                {
                    <RbiAlert Class="codebook-form-alert" Tone="RbiAlertTone.Warning" Title="@T["codes.value-inactive-category"]" />
                }
                <div class="codebook-detail__actions">
                    <RbiButton Disabled="@(_busy || _refreshing)" OnClick="BackToOverviewAsync" Variant="RbiButtonVariant.Secondary"><RbiIcon Name="RbiIconName.ArrowLeft" />@T["codes.all"]</RbiButton>
                    <RbiButton Disabled="@(_busy || _refreshing)" OnClick="OpenColumnsAsync" Variant="RbiButtonVariant.Secondary">@T["codes.column-structure"]</RbiButton>
                    @if (_canWrite && _customColumns && _selectedDefinition is { IsActive: true } currentDefinition)
                    {
                        <RbiButton Disabled="@(_busy || _refreshing)" Variant="RbiButtonVariant.Secondary"
                                   OnClick="() => OpenSchema(currentDefinition)">@T["codes.edit-schema"]</RbiButton>
                    }
                    @if (_selectedDefinition is { } definition)
                    {
                        @if (_canWrite && (!definition.IsSystemRequired || !definition.IsActive))
                        {
                            <RbiSwitch Disabled="@(_busy || _refreshing)" Value="definition.IsActive" ValueExpression="@(() => definition.IsActive)"
                                       ValueChanged="@((bool _) => SetCategoryStatusAsync(definition))">@T["codes.active"]</RbiSwitch>
                        }
                        <div class="codebook-detail__meta">
                            @if (definition.CreatedBy is { Length: > 0 } created) { <span>@T.Format("codes.created-by", created)</span> }
                            @if (definition.ModifiedBy is { Length: > 0 } modified) { <span>@T.Format("codes.modified-by", modified, definition.ModifiedAt is { } at ? AppFormat.Timestamp(at) : "—")</span> }
                        </div>
                    }
                    @if (_canWrite)
                    {
                        <RbiButton Disabled="@(_busy || _refreshing)" OnClick="() => _deleteCategory = _category" Variant="RbiButtonVariant.Destructive"><RbiIcon Name="RbiIconName.Trash2" />@T["codes.delete-category"]</RbiButton>
                    }
                </div>
            </header>
        }
        @if (IsLanguagePack)
        {
            <div class="registry-controls">
                <RegistrySearch Id="code-translation-search" Label="@T["codes.search-translations"]" @bind-Value="_valueSearch" @bind-Value:after="SearchValuesAsync" />
            </div>
        }
        @if (_refreshing) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
        else if (_category.Length == 0) { }
        else if (_values.Count == 0 && _error is null) { <div class="registry-surface"><RegistryEmpty Body="@T[string.IsNullOrWhiteSpace(_valueSearch) ? "codes.empty" : "state.no-match"]" /></div> }
        else if (_error is null)
        {
            <p class="registry-help app-visually-hidden">@T["codes.history"]</p>
            <RbiTable AccessibleLabel="@T["codes.title"]" Class="@(_customColumns ? "registry-table registry-codes-table registry-codes-table--custom" : "registry-table registry-codes-table")"><caption>@_category</caption>
                <thead><tr>
                @if (!_customColumns && IsLanguagePack)
                {
                    <th scope="col">@T["codes.language-code"]</th><th scope="col">@T["codes.resource-key"]</th><th scope="col">@T["codes.context-info"]</th><th scope="col">@T["codes.label-text"]</th><th scope="col">@T["codes.help-text"]</th><th scope="col">@T["codes.placeholder-text"]</th>
                }
                else if (!_customColumns)
                {
                    <th scope="col">@T["codes.code"]</th><th scope="col">@T["codes.name"]</th><th scope="col">@T["codes.description"]</th>
                }
                @foreach (var column in _valueColumns) { <th scope="col">@column.Name</th> }
                <th scope="col" class="registry-center">@T["codes.active"]</th>@if (_canWrite) { <th scope="col" class="registry-center registry-actions-cell">@T["users.actions"]</th> }</tr></thead>
                <tbody>@foreach (var value in _values)
                {
                    <tr @key="value.Id">
                        @if (!_customColumns && IsLanguagePack)
                        {
                            <td>@value.Localization?.LanguageCode</td><td class="registry-strong">@value.Localization?.ResourceKey</td><td>@value.Localization?.ContextInfo</td><td>@value.Localization?.ResourceLabel</td><td>@value.Localization?.ResourceHelper</td><td>@value.Localization?.ResourcePlaceholder</td>
                        }
                        else if (!_customColumns)
                        {
                            <td>@value.Code</td><td class="registry-strong">@value.Value</td><td>@(string.IsNullOrWhiteSpace(value.Description) ? "—" : value.Description)</td>
                        }
                        @foreach (var column in _valueColumns) { <td>@SlotText(value, column.Slot)</td> }
                        <td class="registry-center"><Indicator Kind="@(value.IsActive ? "active" : "inactive")" Label="@T[value.IsActive ? "codes.active" : "codes.inactive"]" /></td>
                        @if (_canWrite) { <td class="registry-actions-cell">@ValueActions(value)</td> }
                    </tr>
                }</tbody>
            </RbiTable>
            @if (ValuePages > 1)
            {
                <p class="page-total" role="status">@T.Format("legal.page-summary", _valuePage, ValuePages, _valueTotal)</p>
                <RbiPagination CurrentPage="_valuePage" CurrentPageChanged="ChangeValuePageAsync" TotalPages="ValuePages"
                               AccessibleLabel="@T["codes.title"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]"
                               NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]"
                               PageAccessibleLabel="@(number => T.Format("legal.page", number))" />
            }
        }
    }
}
@if (_columnsOpen)
{
    <RbiDialog Open Title="@T["codes.column-structure"]" CloseLabel="@T["common.close"]" OpenChanged="@(open => _columnsOpen = open)">
        <DialogBody>
            @if (_columnsError is not null) { <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_columnsError]" /> }
            else if (_columns is null) { <RbiText>@T["state.loading"]</RbiText> }
            else if (_columns.Count == 0) { <RbiText>@T["codes.no-column-structure"]</RbiText> }
            else
            {
                <dl class="codebook-columns">
                    @foreach (var column in _columns)
                    {
                        <div class="codebook-column">
                            <dt><strong>@ColumnLabel(column)</strong> <small>ID@(column.Slot)</small></dt>
                            <dd>@T[column.TypeKey]</dd>
                            @if (ColumnDescription(column) is { } description) { <dd>@description</dd> }
                        </div>
                    }
                </dl>
            }
        </DialogBody>
    </RbiDialog>
}
@if (_schemaOpen)
{
    <RbiDialog Open Class="app-form-dialog app-form-dialog--md" Title="@T[_schemaExisting is null ? "codes.definition-create" : "codes.edit-schema"]"
               CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseSchema">
        <DialogBody><CodebookSchemaForm Existing="_schemaExisting" Columns="@(_schemaExisting is null ? [] : _valueColumns)"
                                       HasValues="@(_valueTotal > 0)" Save="SaveSchemaAsync" Cancel="() => CloseSchema(false)" /></DialogBody>
    </RbiDialog>
}
@if (_customEditorOpen)
{
    <RbiDialog Open Class="app-form-dialog app-form-dialog--md" Title="@T[_customEdit is null ? "codes.create" : "codes.edit"]"
               CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseCustomEditor">
        <DialogBody><CodebookValueForm Value="_customEdit" Columns="_valueColumns"
                                       Save="SaveCellsAsync" Cancel="() => CloseCustomEditor(false)" /></DialogBody>
    </RbiDialog>
}
@if (_draft is { } draft)
{
    <RbiDialog Open Class="app-form-dialog app-form-dialog--sm registry-codes-dialog" Title="@T[draft.Definition ? "codes.definition-create" : draft.Id is null ? "codes.create" : "codes.edit"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseEditor">
        <DialogBody><CodeListForm @key="draft" Model="draft" Save="SaveAsync" Cancel="() => CloseEditor(false)" /></DialogBody>
    </RbiDialog>
}
@if (_deleteValue is not null || _deleteCategory is not null)
{
    <RbiAlertDialog Open Class="registry-codes-dialog" Title="@T[_deleteValue is null ? "codes.delete-category" : "codes.delete-value"]" Description="@T[_deleteValue is null ? "codes.delete-category-permanently" : "codes.delete-help"]" CancelLabel="@T["common.cancel"]" ConfirmLabel="@T["codes.delete-label"]" OnCancel="CancelDelete" OnConfirm="DeleteAsync" Confirming="_busy" ConfirmLoadingLabel="@T["state.loading"]" OpenChanged="CloseDelete" />
}
@if (_preview is { } preview)
{
    <RbiDialog Open Class="registry-codes-dialog codebook-csv-preview" Title="@T["codes.csv.preview-title"]" CloseLabel="@T["common.close"]" OpenChanged="ClosePreview">
        <DialogBody>
            <p>@T.Format("codes.csv.summary", preview.TotalRows, preview.Ready, preview.Duplicates)</p>
            @if (preview.ExampleSkipped) { <p class="app-hint">@T["codes.csv.example-skipped"]</p> }
            @if (preview.Errors.Count > 0)
            {
                @if (preview.TotalRows > preview.Ready + preview.Duplicates)
                {
                    <p>@T.Format("codes.csv.invalid-rows", preview.TotalRows - preview.Ready - preview.Duplicates)</p>
                }
                <ul class="codebook-csv-errors" aria-label="@T["codes.issues"]">
                    @foreach (var error in preview.Errors) { <li>@FormatIssue(error)</li> }
                </ul>
            }
            @if (preview.CanImport && preview.Errors.Count > 0)
            {
                <RbiAlert Tone="RbiAlertTone.Warning" Title="@T["codes.csv.partial-help"]" />
            }
            <div class="registry-toolbar">
                <RbiButton Disabled="_busy" OnClick="() => ClosePreview(false)" Variant="RbiButtonVariant.Secondary">@T["common.cancel"]</RbiButton>
                <RbiButton Disabled="@(_busy || !preview.CanImport)" OnClick="ImportAsync">@T[preview.Errors.Count == 0 || !preview.CanImport ? "codes.csv.confirm" : "codes.csv.confirm-valid"]</RbiButton>
            </div>
        </DialogBody>
    </RbiDialog>
}
@code {
    private RenderFragment ValueActions(CodeValue value) => @<div class="registry-row-actions"><RbiButton Disabled="@(_busy || _refreshing)" OnClick="() => Edit(value)" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["codes.edit"]" title="@T["codes.edit"]"><RbiIcon Name="RbiIconName.Pencil" /></RbiButton><RbiButton Disabled="@(_busy || _refreshing)" OnClick="() => _deleteValue = value" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["codes.delete-value"]" title="@T["codes.delete-value"]" Class="registry-danger-icon"><RbiIcon Name="RbiIconName.Trash2" /></RbiButton></div>;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public CodeLists() => _token = _lifetime.Token;
    private bool _disposed, _authenticated, _canRead, _canWrite, _busy, _loading = true, _refreshing, _loaded;
    private CodeListMetas _overview = new([]);
    private int DefinitionPages => PageCount(_overview.Total, _overview.PageSize);
    private CodeListMeta? _selectedDefinition;
    private readonly LatestPageRequest _definitionRequest = new();
    private IReadOnlyList<CodeValue> _values = [];
    private int _valuePage = 1, _valueTotal, _valuePageSize = 50;
    private int ValuePages => Math.Max(1, (int)Math.Ceiling(_valueTotal / (double)_valuePageSize));
    private IReadOnlyList<CodebookColumn> _valueColumns = [];
    private string SlotText(CodeValue row, int slot) =>
        row.SlotValues?.GetValueOrDefault(slot) is { } value && value.ValueKind != System.Text.Json.JsonValueKind.Null
            ? value.ValueKind switch
            {
                System.Text.Json.JsonValueKind.True => T["common.yes"],
                System.Text.Json.JsonValueKind.False => T["common.no"],
                System.Text.Json.JsonValueKind.String when slot is 9 or 10 => value.ToString().Split('T')[0],
                System.Text.Json.JsonValueKind.String when slot == 11 && value.TryGetDateTime(out var timestamp) =>
                    timestamp.ToString("yyyy-MM-dd HH:mm:ss.FFFFFFF", System.Globalization.CultureInfo.InvariantCulture),
                _ => value.ToString()
            }
            : "—";
    private string _category = "", _pendingCategory = "", _fileName = "";
    private string? _error, _notice, _toastError, _deleteCategory;
    private CodeValue? _deleteValue;
    private CodeListDraft? _draft;
    private bool _customColumns, _schemaOpen, _customEditorOpen;
    private DateTime? _valueModifiedAt;
    private CodeListMeta? _schemaExisting;
    private CodeValue? _customEdit;
    private CodeCsvPreview? _preview;
    private byte[]? _fileBytes;
    private int _fileKey;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return; _loading = !_loaded; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token);
            _canRead = ApplicationAccess.CanViewAdministration(profile) && profile.Permissions.Contains("CODE_LISTS_VIEW");
            _canWrite = _canRead && ApplicationAccess.CanManageAdministration(profile);
            if (!_canRead) return;
            if (_category.Length == 0) await LoadDefinitionsPageAsync(_overview.Page);
            else await LoadValuesAsync();
            _loaded = true;
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = _refreshing = false; }
    }
    private static int PageCount(int total, int size) => Math.Max(1, (int)Math.Ceiling(total / (double)Math.Max(1, size)));
    private Task SearchDefinitionsAsync() => LoadDefinitionsAsync(1, debounce: true);
    private Task LoadDefinitionsPageAsync(int page) => LoadDefinitionsAsync(page);

    private async Task LoadDefinitionsAsync(int page, bool debounce = false)
    {
        if (_disposed || _category.Length > 0) return;
        var search = _search;
        _refreshing = true;
        await _definitionRequest.RunAsync(_token, debounce, async token =>
        {
            var result = await Api.DefinitionsAsync(token, page, search);
            var lastPage = PageCount(result.Total, result.PageSize);
            if (page > lastPage) result = await Api.DefinitionsAsync(token, lastPage, search);
            token.ThrowIfCancellationRequested();
            _overview = result;
            _error = null;
        }, exception => _error = exception.MessageKey, () => _refreshing = false);
    }

    private async Task ChangeValuePageAsync(int page)
    {
        if (_disposed || _refreshing || _busy || page < 1 || page > ValuePages) return;
        _valuePage = page;
        _refreshing = true;
        try { await LoadValuesAsync(); }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _refreshing = false; }
    }

    private string _valueSearch = "";
    private readonly LatestPageRequest _valueRequest = new();

    private async Task SearchValuesAsync()
    {
        if (_disposed || _busy || !IsLanguagePack) return;
        _refreshing = true;
        await _valueRequest.RunAsync(_token, debounce: true, async token =>
        {
            await LoadValuesAsync(1, token);
            _error = null;
        }, exception => _error = exception.MessageKey, () => _refreshing = false);
    }

    private async Task LoadValuesAsync(int? page = null, CancellationToken? cancellation = null)
    {
        var token = cancellation ?? _token;
        var search = IsLanguagePack ? _valueSearch : null;
        var requestedPage = page ?? _valuePage;
        var values = _category.Length == 0 ? null : await Api.ValuesAsync(_category, token, requestedPage, search);
        var lastPage = PageCount(values?.Total ?? 0, values?.PageSize ?? 50);
        if (values is not null && requestedPage > lastPage)
            values = await Api.ValuesAsync(_category, token, lastPage, search);

        token.ThrowIfCancellationRequested();
        _valuePage = values?.Page ?? 1;
        _valueTotal = values?.Total ?? 0;
        _valuePageSize = Math.Max(1, values?.PageSize ?? 50);
        _selectedDefinition = values?.Definition;
        _values = values?.Items ?? [];
        var columns = values?.Columns ?? [];
        var referenceFields = columns.Any(column => column is { Slot: 15, Name: "VALUE_KEY" }) &&
            columns.Any(column => column is { Slot: 17, Name: "NAME" }) &&
            columns.Any(column => column is { Slot: 18, Name: "DESCRIPTION" });
        _customColumns = values is not null && !referenceFields && !IsLanguagePack && _category != "LANGUAGES";
        _valueColumns = _customColumns ? columns : columns.Where(column => column.Slot is not (1 or 15 or 17 or 18) &&
            (!IsLanguagePack || column.Slot is not (12 or 13 or 14 or 16 or 19 or 20)) &&
            (_category != "LANGUAGES" || column.Slot is not (12 or 13))).ToArray();
        _valueModifiedAt = values?.ModifiedAt;
    }

    private bool CategoryInactive => _selectedDefinition is { } definition && !definition.IsActive;

    private async Task SetCategoryStatusAsync(CodeListMeta definition)
    {
        if (!_canWrite || _busy) return;
        _busy = true;
        _toastError = _notice = null;
        try
        {
            _toastError = await Api.SetDefinitionStatusAsync(definition.Name, !definition.IsActive, definition.ModifiedAt, _token);
            if (_toastError is not null) return;
            _notice = T["toast.code-saved"];
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }

    private bool IsLanguagePack => _category.Equals("LANGUAGE_PACKS", StringComparison.OrdinalIgnoreCase);
    private string ColumnLabel(CodebookColumn column) => LanguageColumnKey(column) is { } key ? T[key] : column.Name;
    private string? ColumnDescription(CodebookColumn column) =>
        LanguageColumnKey(column) is { } key ? T[key + ".column-description"] : column.Description;
    private string? LanguageColumnKey(CodebookColumn column) => (_category, column.Slot) switch
    {
        ("LANGUAGES" or "LANGUAGE_PACKS", 1) => "codes.active",
        ("LANGUAGES" or "LANGUAGE_PACKS", 12) => "codes.language-code",
        ("LANGUAGES", 13) => "codes.language-name",
        ("LANGUAGE_PACKS", 13) => "codes.resource-key",
        ("LANGUAGE_PACKS", 14) => "codes.context-info",
        ("LANGUAGE_PACKS", 16) => "codes.label-text",
        ("LANGUAGE_PACKS", 19) => "codes.help-text",
        ("LANGUAGE_PACKS", 20) => "codes.placeholder-text",
        _ => null
    };
    private bool _columnsOpen;
    private IReadOnlyList<CodebookColumn>? _columns;
    private string? _columnsError;
    private async Task OpenColumnsAsync()
    {
        _columns = null;
        _columnsError = null;
        _columnsOpen = true;
        try { _columns = (await Api.ColumnsAsync(_category, _token)).Items; }
        catch (RegistryApiException exception) { _columnsError = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private string _search = "";
    // Values are loaded only for the list the user opens, never for an automatically chosen first one.
    private Task OpenCategoryAsync(string category) { _category = category; _valuePage = 1; _valueSearch = ""; _values = []; _notice = null; return LoadAsync(); }
    private Task BackToOverviewAsync() { _category = ""; _valueSearch = ""; _values = []; _notice = null; return LoadAsync(); }
    private void NewDefinition() => OpenSchema(null);
    private void OpenSchema(CodeListMeta? definition)
    {
        if (!_canWrite || _busy) return;
        _schemaExisting = definition;
        _schemaOpen = true;
    }

    private void CloseSchema(bool open) { if (!open && !_busy) _schemaOpen = false; }
    private void CloseCustomEditor(bool open) { if (!open && !_busy) _customEditorOpen = false; }
    private void NewValue()
    {
        if (!_canWrite || _busy || _category.Length == 0 || CategoryInactive) return;
        if (_customColumns) { _customEdit = null; _customEditorOpen = true; }
        else _draft = new() { Category = _category };
    }

    private void Edit(CodeValue value)
    {
        if (!_canWrite || _busy) return;
        if (_customColumns) { _customEdit = value; _customEditorOpen = true; }
        else _draft = CodeListDraft.From(value);
    }

    private async Task<string?> SaveSchemaAsync(string name, string? description, IReadOnlyList<CodebookColumnInput> columns)
    {
        if (!_canWrite || _busy) return "errors.forbidden";
        _busy = true;
        StateHasChanged();
        try
        {
            if (_schemaExisting is { } definition)
            {
                var error = await Api.SaveDefinitionAsync(definition.Name, description, _valueModifiedAt ?? definition.ModifiedAt, columns, _token);
                if (error is not null) return error;
                _notice = T["toast.code-saved"];
            }
            else
            {
                var result = await Api.CreateCategoryAsync(name, description, _token, columns);
                if (result.Name is null) return result.ErrorKey;
                _category = result.Name;
                _valuePage = 1;
                _notice = T["toast.code-def"];
            }
            _schemaOpen = false;
            await LoadAsync();
            return null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return null; }
        finally
        {
            _busy = false;
            if (!_disposed) StateHasChanged();
        }
    }

