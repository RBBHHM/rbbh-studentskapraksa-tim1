@page "/app/admin/role-catalog"
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IRoleCatalogApi Api

<PageTitle>@T["rolecatalog.title"]</PageTitle>
<HeroBar Title="@T["rolecatalog.title"]" Description="@T["rolecatalog.description"]" Eyebrow="@T["nav.area.administration"]">
    <Actions>
        @if (_canWrite && !_loading)
        {
            <RbiButton OnClick="NewRole" Disabled="@(_busy || _refreshing)"><RbiIcon Name="RbiIconName.Plus" />@T["rolecatalog.new"]</RbiButton>
        }
    </Actions>
</HeroBar>
@if (!_authenticated && !_loading) { <IdentityNotice /> }
else if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (!_canRead) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    @if (_error is not null)
    {
        <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
        <RbiButton OnClick="LoadAsync" Disabled="_refreshing">@T["state.retry"]</RbiButton>
    }
    @if (_notice is not null) { <div role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@T[_notice]" /></div> }
    <div class="registry-controls">
        <label class="app-label" for="rolecatalog-search">@T["rolecatalog.search"]</label>
        <input id="rolecatalog-search" class="rbi-input" maxlength="100" @bind="_search" @bind:event="oninput" />
        <RbiButton OnClick="SearchAsync" Disabled="@(_busy || _refreshing)">@T["rolecatalog.search-action"]</RbiButton>
    </div>
    @if (_page.Items.Count == 0 && _error is null)
    {
        <div class="registry-surface"><RegistryEmpty Body="@T["rolecatalog.empty"]" /></div>
    }
    else if (_error is null)
    {
        <RbiTable AccessibleLabel="@T["rolecatalog.title"]" Class="registry-table">
            <thead>
                <tr>
                    <th scope="col">@T["rolecatalog.name"]</th>
                    <th scope="col">@T["rolecatalog.display-name"]</th>
                    <th scope="col">@T["rolecatalog.permissions"]</th>
                    <th scope="col">@T["rolecatalog.status"]</th>
                    <th scope="col">@T["common.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in _page.Items)
                {
                    <tr @key="role.Id">
                        <td class="registry-strong">@role.Name</td>
                        <td>@role.DisplayName</td>
                        <td>@role.PermissionIds.Count</td>
                        <td><Indicator Kind="@(role.IsActive ? "active" : "inactive")" Label="@T[role.IsActive ? "codes.active" : "codes.inactive"]" /></td>
                        <td>
                            @if (_canWrite && !role.IsProtected)
                            {
                                <RbiButton Variant="RbiButtonVariant.Secondary" Disabled="@(_busy || _refreshing)" OnClick="() => EditRole(role)">@T["rolecatalog.edit"]</RbiButton>
                            }
                            else
                            {
                                <span class="app-hint">@T[role.IsProtected ? "rolecatalog.protected" : "rolecatalog.read-only"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </RbiTable>
    }
    <p class="page-total" role="status">@T.Format("rolecatalog.total", _page.Total)</p>
    @if (TotalPages > 1)
    {
        <RbiPagination CurrentPage="_pageNumber" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["rolecatalog.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(number => T.Format("legal.page", number))" />
    }
}
@if (_draft is { } draft)
{
    <RbiDialog Open Class="app-form-dialog app-form-dialog--md" Title="@T[draft.Id is null ? "rolecatalog.new" : "rolecatalog.edit"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseDialog">
        <DialogBody>
            <form class="registry-period-form" @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
                @if (draft.Id is null)
                {
                    <label class="app-label" for="rolecatalog-name">@T["rolecatalog.name"]</label>
                    <input id="rolecatalog-name" class="rbi-input" maxlength="100" required @bind="draft.Name" @bind:event="oninput" />
                }
                else
                {
                    <p><strong>@T["rolecatalog.name"]:</strong> @draft.Name</p>
                }
                <label class="app-label" for="rolecatalog-display-name">@T["rolecatalog.display-name"]</label>
                <input id="rolecatalog-display-name" class="rbi-input" maxlength="100" required @bind="draft.DisplayName" @bind:event="oninput" />
                <label class="app-label" for="rolecatalog-description">@T["rolecatalog.description-field"]</label>
                <textarea id="rolecatalog-description" class="rbi-textarea" rows="2" maxlength="500" @bind="draft.Description" @bind:event="oninput"></textarea>
                @if (draft.Id is not null)
                {
                    <label class="app-label" for="rolecatalog-active">
                        <input id="rolecatalog-active" type="checkbox" @bind="draft.IsActive" />
                        @T["rolecatalog.active"]
                    </label>
                }
                <fieldset class="registry-surface">
                    <legend>@T["rolecatalog.permissions"]</legend>
                    @foreach (var group in _permissions.GroupBy(item => item.Module).OrderBy(item => item.Key))
                    {
                        <h3>@group.Key</h3>
                        @foreach (var permission in group)
                        {
                            <label class="app-label" for="@("rolecatalog-permission-" + permission.Id.ToString("N"))">
                                <input id="@("rolecatalog-permission-" + permission.Id.ToString("N"))" type="checkbox" checked="@draft.PermissionIds.Contains(permission.Id)" @onchange="args => SelectPermission(permission.Id, args.Value is true)" />
                                @permission.Code
                            </label>
                        }
                    }
                </fieldset>
                @if (_formError is not null) { <p role="alert" class="app-error">@T[_formError]</p> }
                <div class="registry-toolbar">
                    <RbiButton Variant="RbiButtonVariant.Secondary" Disabled="_busy" OnClick="() => CloseDialog(false)">@T["common.cancel"]</RbiButton>
                    <RbiButton Type="RbiButtonType.Submit" Disabled="@(_busy || !ValidDraft)">@T["common.save"]</RbiButton>
                </div>
            </form>
        </DialogBody>
    </RbiDialog>
}
@code {
    private sealed class RoleDraft
    {
        public Guid? Id { get; init; }
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public int Version { get; init; }
        public HashSet<Guid> PermissionIds { get; init; } = [];
    }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public RoleCatalog() => _token = _lifetime.Token;
    private bool _disposed, _authenticated, _canRead, _canWrite, _loading = true, _refreshing, _busy;
    private int _pageNumber = 1;
    private string _search = "";
    private string? _error, _formError, _notice;
    private RoleCatalogPage _page = new([], 0, 1, 20);
    private IReadOnlyList<RolePermissionOption> _permissions = [];
    private RoleDraft? _draft;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_page.Total / (double)Math.Max(1, _page.PageSize)));
    private bool ValidDraft => _draft is { } draft &&
        (draft.Id is not null || (System.Text.RegularExpressions.Regex.IsMatch(draft.Name.Trim(), "^[A-Za-z0-9_.-]{1,100}$") &&
         !draft.Name.Trim().Equals("admin", StringComparison.OrdinalIgnoreCase) &&
         !draft.Name.Trim().Equals("gost", StringComparison.OrdinalIgnoreCase))) &&
        !string.IsNullOrWhiteSpace(draft.DisplayName) && draft.DisplayName.Length <= 100 &&
        draft.Description.Length <= 500;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token);
            _canRead = ApplicationAccess.IsAdministrator(profile) && profile.Permissions.Contains("ADMINISTRATION_VIEW");
            _canWrite = _canRead && profile.Permissions.Contains("ADMINISTRATION_MANAGE");
            if (!_canRead) return;
            _page = await Api.ListAsync(_pageNumber, _search, _token);
            _permissions = (await Api.PermissionsAsync(_token)).Items;
            if (_pageNumber > TotalPages)
            {
                _pageNumber = TotalPages;
                _page = await Api.ListAsync(_pageNumber, _search, _token);
            }
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; _refreshing = false; }
    }

    private async Task SearchAsync() { if (_busy || _refreshing) return; _pageNumber = 1; await LoadAsync(); }
    private async Task ChangePageAsync(int page) { if (_busy || _refreshing || page < 1 || page > TotalPages) return; _pageNumber = page; await LoadAsync(); }
    private void NewRole() { if (_canWrite && !_busy) { _formError = null; _draft = new(); } }
    private void EditRole(RoleDefinition role)
    {
        if (!_canWrite || role.IsProtected || _busy) return;
        _formError = null;
        _draft = new()
        {
            Id = role.Id,
            Name = role.Name,
            DisplayName = role.DisplayName,
            Description = role.Description ?? "",
            IsActive = role.IsActive,
            Version = role.Version,
            PermissionIds = role.PermissionIds.ToHashSet()
        };
    }
    private void SelectPermission(Guid id, bool selected)
    {
        if (_draft is null) return;
        if (selected) _draft.PermissionIds.Add(id);
        else _draft.PermissionIds.Remove(id);
    }
    private void CloseDialog(bool open) { if (!open && !_busy) _draft = null; }

    private async Task SaveAsync()
    {
        if (!_canWrite || !ValidDraft || _draft is not { } draft || _busy) return;
        _busy = true;
        _formError = null;
        try
        {
            if (draft.Id is { } id)
                await Api.UpdateAsync(id, new(draft.DisplayName.Trim(), string.IsNullOrWhiteSpace(draft.Description) ? null : draft.Description.Trim(), draft.IsActive, draft.Version, draft.PermissionIds.ToArray()), _token);
            else
                await Api.CreateAsync(new(draft.Name.Trim(), draft.DisplayName.Trim(), string.IsNullOrWhiteSpace(draft.Description) ? null : draft.Description.Trim(), draft.PermissionIds.ToArray()), _token);
            _draft = null;
            _notice = "rolecatalog.saved";
            await LoadAsync();
        }
        catch (RegistryApiException exception) { _formError = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
