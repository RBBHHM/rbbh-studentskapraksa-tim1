@page "/app/admin/role-catalog"
@implements IDisposable
@using RBI.DesignSystem.Components.Forms
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IRoleCatalogApi Api

<PageTitle>@T["rolecatalog.title"]</PageTitle>
<HeroBar Title="@T["rolecatalog.title"]" Description="@T["rolecatalog.description"]" Eyebrow="@T["nav.area.administration"]">
    <Actions>
        @if (_canWrite && !_loading)
        {
            <RbiButton OnClick="NewRole" Disabled="@(_busy || _refreshing)"><RbiIcon Name="RbiIconName.Plus" />@T["rolecatalog.new"]</RbiButton>
        }
    </Actions>
</HeroBar>
@if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (!_canRead) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    @if (_error is not null)
    {
        <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
        <RbiButton OnClick="LoadAsync" Disabled="_refreshing">@T["state.retry"]</RbiButton>
    }
    @if (_deleteError is not null)
    {
        <RbiAlert Class="role-catalog-alert" Tone="RbiAlertTone.Danger" Title="@T[_deleteError]" Announcement="RbiAlertAnnouncement.Assertive" />
    }
    @if (_notice is not null) { <div role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@T[_notice]" /></div> }
    <div class="role-catalog-search">
        <RbiIcon Name="RbiIconName.Search" />
        <input id="rolecatalog-search" type="search" class="rbi-input" maxlength="100"
               aria-label="@T["rolecatalog.search"]" placeholder="@T["rolecatalog.search"]"
               value="@_search" @oninput="SearchAsync" />
    </div>
    @if (_page.Items.Count == 0 && _error is null)
    {
        <div class="registry-surface"><RegistryEmpty Body="@T["rolecatalog.empty"]" /></div>
    }
    else if (_error is null)
    {
        <RbiTable AccessibleLabel="@T["rolecatalog.title"]" Class="registry-table registry-reflow-table">
            <thead>
                <tr>
                    <th scope="col">@T["rolecatalog.name"]</th>
                    <th scope="col">@T["rolecatalog.description-field"]</th>
                    <th scope="col">@T["rolecatalog.permissions"]</th>
                    <th scope="col">@T["rolecatalog.status"]</th>
                    <th scope="col">@T["common.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in _page.Items)
                {
                    <tr @key="role.Id">
                        <td class="registry-strong"><span class="registry-cell-label" aria-hidden="true">@T["rolecatalog.name"]</span><span>@(role.Name.Equals("gost", StringComparison.OrdinalIgnoreCase) ? T.Role(role.Name) : role.Name)</span></td>
                        <td><span class="registry-cell-label" aria-hidden="true">@T["rolecatalog.description-field"]</span><span>@(string.IsNullOrWhiteSpace(role.Description) ? "—" : role.Description)</span></td>
                        <td><span class="registry-cell-label" aria-hidden="true">@T["rolecatalog.permissions"]</span>@role.PermissionIds.Count</td>
                        <td><span class="registry-cell-label" aria-hidden="true">@T["rolecatalog.status"]</span><Indicator Kind="@(role.IsActive ? "active" : "inactive")" Label="@T[role.IsActive ? "codes.active" : "codes.inactive"]" /></td>
                        <td><span class="registry-cell-label" aria-hidden="true">@T["common.actions"]</span>
                            @if (_canWrite && !role.IsProtected)
                            {
                                <div class="role-catalog-actions">
                                    <RbiButton Variant="RbiButtonVariant.Secondary" Disabled="@(_busy || _refreshing)" OnClick="() => EditRole(role)">@T["rolecatalog.edit"]</RbiButton>
                                    <RbiButton Variant="RbiButtonVariant.Ghost" Class="role-catalog-delete" Disabled="@(_busy || _refreshing)" OnClick="() => ConfirmDelete(role)">@T["common.delete"]</RbiButton>
                                </div>
                            }
                            else
                            {
                                <span class="app-hint">@T[role.IsProtected ? "rolecatalog.protected" : "rolecatalog.read-only"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </RbiTable>
    }
    <p class="page-total" role="status">@T.Format("rolecatalog.total", _page.Total)</p>
    @if (TotalPages > 1)
    {
        <RbiPagination CurrentPage="_pageNumber" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["rolecatalog.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(number => T.Format("legal.page", number))" />
    }
}
@if (_deleteTarget is { } target)
{
    <RbiAlertDialog Open Title="@T["rolecatalog.delete-title"]"
                    Description="@T.Format("rolecatalog.delete-description", target.Name)"
                    CancelLabel="@T["common.cancel"]" ConfirmLabel="@T["common.delete"]"
                    Confirming="_busy" ConfirmLoadingLabel="@T["state.loading"]"
                    OnConfirm="DeleteAsync" OpenChanged="CloseDelete" />
}
@if (_draft is { } draft)
{
    <RbiDialog Open Class="app-form-dialog role-catalog-dialog" Title="@T[draft.Id is null ? "rolecatalog.new" : "rolecatalog.edit"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseDialog">
        <DialogBody>
            <form id="role-catalog-editor" class="role-catalog-form" @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
                <RbiTabs TValue="string" @bind-Value="_editorTab" Class="role-catalog-tabs" AccessibleLabel="@T[draft.Id is null ? "rolecatalog.new" : "rolecatalog.edit"]">
                    <TabList>
                        <RbiTab TValue="string" Value="@("details")">@T["rolecatalog.details"]</RbiTab>
                        <RbiTab TValue="string" Value="@("permissions")">@T["rolecatalog.permissions"]</RbiTab>
                    </TabList>
                    <ChildContent>
                        <RbiTabPanel TValue="string" Value="@("details")">
                            <div class="role-catalog-fields">
                                <div class="role-catalog-field">
                                    <label for="rolecatalog-name">@T["rolecatalog.name"] @if (draft.Id is null) { <span aria-hidden="true">*</span> }</label>
                                    <RbiInput Id="rolecatalog-name" maxlength="100" Required ReadOnly="@(draft.Id is not null)"
                                              Invalid="@(NameError is not null)" aria-describedby="@(NameError is not null ? "rolecatalog-name-error" : null)"
                                              UpdateMode="RbiInputUpdateMode.Input" @bind-Value="draft.Name" @bind-Value:after="ClearFormError" @onblur="ShowValidation" />
                                    @if (NameError is { } nameError) { <p class="app-error" id="rolecatalog-name-error" role="status">@T[nameError]</p> }
                                </div>
                                <div class="role-catalog-field">
                                    <label for="rolecatalog-description">@T["rolecatalog.description-field"]</label>
                                    <RbiTextArea Id="rolecatalog-description" Rows="2" maxlength="500"
                                                 Invalid="@(DescriptionError is not null)" aria-describedby="@(DescriptionError is not null ? "rolecatalog-description-error" : null)"
                                                 @bind-Value="draft.Description" @onblur="ShowValidation" />
                                    @if (DescriptionError is { } descriptionError) { <p class="app-error" id="rolecatalog-description-error" role="status">@T[descriptionError]</p> }
                                </div>
                            </div>
                            @if (draft.Id is not null)
                            {
                                <RbiCheckbox Id="rolecatalog-active" @bind-Value="draft.IsActive">@T["rolecatalog.active"]</RbiCheckbox>
                            }
                        </RbiTabPanel>
                        <RbiTabPanel TValue="string" Value="@("permissions")">
                            @if (draft.Permissions.Length > 0)
                            {
                                <RbiSelect TValue="string" Id="rolecatalog-module" aria-label="@T["rolecatalog.permission-module"]" @bind-Value="_permissionModule">
                                    @foreach (var module in draft.Modules)
                                    {
                                        <option value="@module">@module</option>
                                    }
                                </RbiSelect>
                                <div class="role-catalog-permission-grid">
                                    @foreach (var choice in draft.Permissions.Where(choice => choice.Option.Module == _permissionModule))
                                    {
                                        <RbiCheckbox @key="choice.Option.Id" Id="@($"rolecatalog-permission-{choice.Option.Id}")" @bind-Value="choice.Selected">@choice.Option.Code</RbiCheckbox>
                                    }
                                </div>
                            }
                        </RbiTabPanel>
                    </ChildContent>
                </RbiTabs>
                @if (_formError is not null)
                {
                    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_formError]" Announcement="RbiAlertAnnouncement.Assertive" />
                }
            </form>
        </DialogBody>
        <DialogFooter>
            <RbiButton Variant="RbiButtonVariant.Secondary" Disabled="_busy" OnClick="() => CloseDialog(false)">@T["common.cancel"]</RbiButton>
            <RbiButton Type="RbiButtonType.Submit" form="role-catalog-editor" Disabled="_busy">@T["common.save"]</RbiButton>
        </DialogFooter>
    </RbiDialog>
}
@code {
    private sealed class PermissionChoice(RolePermissionOption option, bool selected)
    {
        public RolePermissionOption Option { get; } = option;
        public bool Selected { get; set; } = selected;
    }

    private sealed class RoleDraft
    {
        public long? Id { get; init; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public DateTime Version { get; init; }
        public PermissionChoice[] Permissions { get; init; } = [];
        public IEnumerable<string> Modules => Permissions.Select(choice => choice.Option.Module).Distinct();
        public IEnumerable<long> OtherPermissionIds { get; init; } = [];
        public long[] SelectedPermissionIds => Permissions.Where(choice => choice.Selected)
            .Select(choice => choice.Option.Id).Concat(OtherPermissionIds).ToArray();
    }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public RoleCatalog() => _token = _lifetime.Token;
    private bool _disposed, _authenticated, _canRead, _canWrite, _loading = true, _refreshing, _busy;
    private int _pageNumber = 1;
    private string _search = "";
    private CancellationTokenSource? _searchRequest;
    private string? _error, _formError, _deleteError, _notice;
    private RoleDefinition? _deleteTarget;
    private RoleCatalogPage _page = new([], 0, 1, 20);
    private IReadOnlyList<RolePermissionOption> _permissions = [];
    private RoleDraft? _draft;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_page.Total / (double)Math.Max(1, _page.PageSize)));
    private bool _showValidation;
    private string _editorTab = "details", _permissionModule = "";
    private string? NameError
    {
        get
        {
            if (!_showValidation || _draft is not { Id: null } draft) return null;
            var name = draft.Name.Trim();
            if (name.Length == 0) return "rolecatalog.name-required";
            return !System.Text.RegularExpressions.Regex.IsMatch(name, "^[A-Za-z0-9_.-]{1,100}$")
                || name.Equals("admin", StringComparison.OrdinalIgnoreCase)
                || name.Equals("gost", StringComparison.OrdinalIgnoreCase)
                ? "rolecatalog.invalid-name" : null;
        }
    }
    private string? DescriptionError => _showValidation && _draft is { } draft && draft.Description.Length > 500
        ? "rolecatalog.description-too-long" : null;

    private void ShowValidation() => _showValidation = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return;
        _refreshing = true;
        _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            var profile = await Profile.GetAsync(_token);
            _canRead = ApplicationAccess.IsAdministrator(profile) && profile.Permissions.Contains("ADMINISTRATION_VIEW");
            _canWrite = _canRead && profile.Permissions.Contains("ADMINISTRATION_MANAGE");
            if (!_canRead) return;
            _page = await Api.ListAsync(_pageNumber, _search.Trim(), _token);
            if (_canWrite && _permissions.Count == 0)
                _permissions = (await Api.PermissionsAsync(_token)).Items;
            if (_pageNumber > TotalPages)
            {
                _pageNumber = TotalPages;
                _page = await Api.ListAsync(_pageNumber, _search.Trim(), _token);
            }
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; _refreshing = false; }
    }

    private async Task SearchAsync(ChangeEventArgs args)
    {
        if (_disposed) return;
        _search = args.Value?.ToString() ?? "";
        _searchRequest?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_token);
        _searchRequest = request;
        try
        {
            await Task.Delay(250, request.Token);
            while (_refreshing || _busy)
                await Task.Delay(50, request.Token);

            var results = await Api.ListAsync(1, _search.Trim(), request.Token);
            request.Token.ThrowIfCancellationRequested();
            _pageNumber = 1;
            _page = results;
            _error = null;
        }
        catch (RegistryApiException exception)
        {
            if (!request.IsCancellationRequested) _error = exception.MessageKey;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_searchRequest, request)) _searchRequest = null;
        }
    }
    private async Task ChangePageAsync(int page) { if (_busy || _refreshing || _searchRequest is not null || page < 1 || page > TotalPages) return; _pageNumber = page; await LoadAsync(); }
    private void NewRole()
    {
        if (_canWrite && !_busy) OpenEditor();
    }

    private void EditRole(RoleDefinition role)
    {
        if (_canWrite && !role.IsProtected && !_busy) OpenEditor(role);
    }

    private void OpenEditor(RoleDefinition? role = null)
    {
        _showValidation = false;
        _formError = null;
        _editorTab = "details";
        var selected = role?.PermissionIds.ToHashSet() ?? [];
        _draft = new()
        {
            Id = role?.Id,
            Name = role?.Name ?? "",
            Description = role?.Description ?? "",
            IsActive = role?.IsActive ?? true,
            Version = role?.Version ?? default,
            OtherPermissionIds = selected.Except(_permissions.Select(permission => permission.Id)).ToArray(),
            Permissions = _permissions.OrderBy(permission => permission.Module).ThenBy(permission => permission.Code)
                .Select(permission => new PermissionChoice(permission, selected.Contains(permission.Id))).ToArray()
        };
        _permissionModule = _draft.Modules.FirstOrDefault() ?? "";
    }
    private void ClearFormError()
    {
        if (_formError == "errors.roles.duplicate.name") _formError = null;
    }

    private void CloseDialog(bool open) { if (!open && !_busy) _draft = null; }

    private void ConfirmDelete(RoleDefinition role)
    {
        if (!_canWrite || role.IsProtected || _busy || _refreshing) return;
        _deleteError = null;
        _notice = null;
        _deleteTarget = role;
    }

    private void CloseDelete(bool open)
    {
        if (!open && !_busy) _deleteTarget = null;
    }

    private async Task DeleteAsync()
    {
        if (!_canWrite || _busy || _deleteTarget is not { } target) return;
        _busy = true;
        try
        {
            await Api.DeleteAsync(target.Id, target.Version, _token);
            _notice = "rolecatalog.deleted";
            await LoadAsync();
        }
        catch (RegistryApiException exception) { _deleteError = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; _deleteTarget = null; }
    }

    private async Task SaveAsync()
    {
        if (!_canWrite || _draft is not { } draft || _busy) return;
        _showValidation = true;
        if (NameError is not null || DescriptionError is not null)
        {
            _editorTab = "details";
            return;
        }
        _busy = true;
        _formError = null;
        try
        {
            if (draft.Id is { } id)
                await Api.UpdateAsync(id, new(null, string.IsNullOrWhiteSpace(draft.Description) ? null : draft.Description.Trim(), draft.IsActive, draft.Version, draft.SelectedPermissionIds), _token);
            else
                await Api.CreateAsync(new(draft.Name.Trim(), null, string.IsNullOrWhiteSpace(draft.Description) ? null : draft.Description.Trim(), draft.SelectedPermissionIds), _token);
            _draft = null;
            _notice = "rolecatalog.saved";
            await LoadAsync();
        }
        catch (RegistryApiException exception)
        {
            _formError = exception.MessageKey;
            if (_formError == "errors.roles.duplicate.name") _editorTab = "details";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
