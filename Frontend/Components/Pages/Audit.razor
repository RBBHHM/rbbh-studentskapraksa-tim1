@page "/app/admin/audit"
@using RBI.DesignSystem.Components.Forms
@using RBBH.RelatedPartiesRegister.Web.Components.Registry
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IAuditApi Api

<PageTitle>@T["audit.title"]</PageTitle>
<HeroBar Title="@T["audit.title"]" Description="@T["audit.subtitle"]" Eyebrow="@T["nav.area.administration"]">
</HeroBar>
@if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (_error is not null)
{
    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else if (!_admin) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    <div class="registry-controls"><RegistrySearch Id="audit-search" Label="@T["audit.search"]" @bind-Value="_search" @bind-Value:after="SearchAsync" /></div>
    @if (_result.Logs.Count == 0) { <div class="registry-surface"><RegistryEmpty Body="@T[string.IsNullOrWhiteSpace(_search) ? "audit.empty" : "state.no-match"]" /></div> }
    else
    {
        <RbiTable AccessibleLabel="@T["audit.title"]" Class="registry-table registry-audit-table">
            <thead><tr><th scope="col">@T["audit.time"]</th><th scope="col">@T["audit.action"]</th><th scope="col">@T["audit.area"]</th><th scope="col">@T["audit.change"]</th><th scope="col">@T["audit.user"]</th></tr></thead>
            <tbody>@foreach (var entry in _result.Logs)
            {
                <tr @key="entry.Id">
                    <td>@AppFormat.Timestamp(entry.Timestamp)</td>
                    <td><span class="audit-badge audit-badge--@AuditChange.Tone(entry.Action)">@entry.ActionDisplay</span></td>
                    <td>@entry.AreaDisplay</td>
                    <td>
                        @if (_changes.TryGetValue(entry.Id, out var changes) && changes.Count > 0)
                        {
                            <ul class="audit-summary">
                                @foreach (var change in changes.Take(3))
                                {
                                    <li>
                                        <strong>@FieldLabel(change.Field)</strong>
                                        <span>@Value(change.Old) <span aria-hidden="true">→</span> @Value(change.New)</span>
                                    </li>
                                }
                            </ul>
                            @if (changes.Count > 3)
                            {
                                <span class="audit-summary-more">@T.Format("audit.more-changes", changes.Count - 3)</span>
                            }
                        }
                        else
                        {
                            <span>@T["audit.no-changes"]</span>
                        }
                        <RbiButton Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Small" OnClick="() => OpenDetail(entry)"
                                   AccessibleLabel="@($"{T["audit.details"]}: {entry.ActionDisplay} {entry.AreaDisplay} {AppFormat.Timestamp(entry.Timestamp)}")">
                            @T["audit.details"]
                        </RbiButton>
                    </td>
                    <td>@entry.Username</td>
                </tr>
            }</tbody>
        </RbiTable>
    }
    @if (TotalPages > 1)
    {
        <p class="page-total" role="status">@T.Format("audit.page-summary", _page, TotalPages, _result.Total)</p>
    <RbiPagination CurrentPage="_page" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["audit.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("legal.page", page))" />
    }
}
@if (_detail is { } detail)
{
    <RbiDialog Open Class="app-form-dialog audit-detail-dialog" Title="@T["audit.details"]" CloseLabel="@T["common.close"]" OpenChanged="CloseDetail">
        <DialogBody>
            <div class="audit-detail-meta">
                <span class="audit-badge audit-badge--@AuditChange.Tone(detail.Action)">@detail.ActionDisplay</span>
                <dl>
                    <div><dt>@T["audit.area"]</dt><dd>@detail.AreaDisplay</dd></div>
                    <div><dt>@T["audit.user"]</dt><dd>@detail.Username</dd></div>
                    <div><dt>@T["audit.time"]</dt><dd>@AppFormat.Timestamp(detail.Timestamp)</dd></div>
                </dl>
            </div>
            @{ var changes = _changes[detail.Id]; }
            @if (changes.Count > 0)
            {
                <RbiTable AccessibleLabel="@T["audit.change"]" Class="registry-table audit-detail-table registry-reflow-table">
                    <thead><tr><th scope="col">@T["audit.field"]</th><th scope="col">@T["audit.old"]</th><th scope="col">@T["audit.new"]</th></tr></thead>
                    <tbody>@foreach (var change in changes.Skip((_detailPage - 1) * DetailPageSize).Take(DetailPageSize))
                    {
                        <tr class="audit-row audit-row--@change.Kind.ToString().ToLowerInvariant()"><th scope="row">@FieldLabel(change.Field)</th>
                            <td><span class="registry-cell-label" aria-hidden="true">@T["audit.old"]</span><span>@Value(change.Old)</span></td>
                            <td><span class="registry-cell-label" aria-hidden="true">@T["audit.new"]</span><span>@Value(change.New)</span></td></tr>
                    }</tbody>
                </RbiTable>
                @if (changes.Count > DetailPageSize)
                {
                    <RbiPagination @bind-CurrentPage="_detailPage" TotalPages="@((changes.Count + DetailPageSize - 1) / DetailPageSize)"
                                   AccessibleLabel="@T["audit.change"]" PreviousLabel="@T["common.back"]" NextLabel="@T["common.actions.continue"]"
                                   PreviousAccessibleLabel="@T["legal.previous"]" NextAccessibleLabel="@T["legal.next"]"
                                   PageAccessibleLabel="@(number => T.Format("legal.page", number))" />
                }
            }
            else
            {
                <p>@T["audit.no-changes"]</p>
            }
        </DialogBody>
    </RbiDialog>
}
@code {
    private static readonly System.Text.RegularExpressions.Regex FieldWords = new(
        "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])");
    private static readonly HashSet<string> LocalizedFields = new(StringComparer.OrdinalIgnoreCase)
    {
        "Name", "IsActive", "PermissionIds", "Roles", "Definition", "Columns", "Values", "Description", "DataType",
        "Slot", "DisplayOrder", "CreatedBy", "ModifiedBy", "CreatedAt", "ModifiedAt", "LegalEntityId", "DefinitionId",
        "RelatedPersonId", "RelatedToPersonId", "ParentFamilyMemberId", "CapitalId"
    };
    private Dictionary<long, IReadOnlyList<AuditFieldChange>> _changes = [];

    private string FieldLabel(string path)
    {
        var colon = path.IndexOf(": ", StringComparison.Ordinal);
        if (path.StartsWith("ID", StringComparison.OrdinalIgnoreCase) && colon > 2 &&
            int.TryParse(path.AsSpan(2, colon - 2), out _))
            return path[(colon + 2)..];
        return string.Join(" / ", path.Split('.').Select(LabelSegment));
    }

    private string LabelSegment(string segment)
    {
        var index = segment.IndexOf(" [", StringComparison.Ordinal);
        var field = index < 0 ? segment : segment[..index];
        var name = LocalizedFields.Contains(field) ? T[$"audit.fields.{field.ToLowerInvariant()}"]
            : FieldWords.Replace(field.Replace('_', ' '), " ");
        return index < 0 ? name : name + segment[index..];
    }

    private static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private const int DetailPageSize = 6;
    private int _detailPage = 1;
    private AuditRecord? _detail;
    private void OpenDetail(AuditRecord detail)
    {
        _detailPage = 1;
        _detail = detail;
    }
    private void CloseDetail(bool open) { if (!open) _detail = null; }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public Audit() => _token = _lifetime.Token;
    private AuditPage _result = new([], 0, 1, 200);
    private string? _search, _error;
    private int _page = 1;
    private bool _disposed, _authenticated, _admin, _loading = true, _refreshing, _loaded;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_result.Total / (double)Math.Max(1, _result.PageSize)));

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_disposed || _refreshing) return; _loading = !_loaded; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) { _admin = false; return; }
            _admin = ApplicationAccess.IsAdministrator(await Profile.GetAsync(_token));
            if (!_admin) return;
            await LoadPageAsync(_page);
            _loaded = true;
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; _refreshing = false; }
    }
    private readonly LatestPageRequest _pageRequest = new();

    private Task SearchAsync() => LoadPageAsync(1, debounce: true);
    private Task ChangePageAsync(int page) => LoadPageAsync(page);

    private async Task LoadPageAsync(int page, bool debounce = false)
    {
        if (_disposed) return;
        var search = _search;
        _refreshing = true;
        await _pageRequest.RunAsync(_token, debounce, async token =>
        {
            var result = await Api.GetAsync(page, token, search);
            var lastPage = Math.Max(1, (int)Math.Ceiling(result.Total / (double)Math.Max(1, result.PageSize)));
            if (page > lastPage) result = await Api.GetAsync(lastPage, token, search);
            token.ThrowIfCancellationRequested();
            _result = result;
            _page = result.Page;
            _error = null;
            _changes = _result.Logs.ToDictionary(entry => entry.Id, entry => (IReadOnlyList<AuditFieldChange>)AuditChange
                .Compare(entry.OldValues, entry.NewValues, _result.PermissionCodes, T["common.yes"], T["common.no"], T["audit.unavailable-reference"], _result.ReferenceNames)
                .Where(change => change.Kind != AuditChangeKind.Unchanged).ToArray());
        }, exception => _error = exception.MessageKey, () => _refreshing = false);
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
