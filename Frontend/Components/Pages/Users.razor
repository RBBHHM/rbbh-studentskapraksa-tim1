@page "/app/admin/users"
@using RBBH.RelatedPartiesRegister.Web.Components.Registry
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject IProfileApi Profile
@inject IUsersApi Api

<PageTitle>@T["users.page-title"]</PageTitle>
<HeroBar Title="@T["users.page-title"]" Description="@T["users.subtitle"]">
    <Actions>
        @if (_authenticated && _canRead && !_loading && _error is null)
        {

            @if (_canWrite) { <RbiButton Disabled="@(_busy || _refreshing)" OnClick="() => Edit(null)"><RbiIcon Name="RbiIconName.Plus" />@T["users.add"]</RbiButton> }
        }
    </Actions>
</HeroBar>
@if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
else if (_error is not null)
{
    <RbiAlert Tone="RbiAlertTone.Danger" Title="@T[_error]" />
    <RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton>
}
else if (!_canRead) { <RbiAlert Title="@T["errors.forbidden"]" /> }
else
{
    <div class="registry-controls users-list-filters">
        <div class="role-catalog-search">
            <RbiIcon Name="RbiIconName.Search" />
            <input type="search" class="rbi-input" maxlength="200" value="@_search"
                   aria-label="@T["users.search"]" placeholder="@T["users.search"]" @oninput="SearchAsync" />
        </div>
        <select class="rbi-control rbi-select" aria-label="@T["users.role-filter"]" value="@_roleFilter" @onchange="FilterRoleAsync">
            <option value="">@T["users.all-roles"]</option>
            <option value="@GuestRole">@RoleLabel(GuestRole)</option>
            @foreach (var role in _roles.Roles.Where(role => !role.Name.Equals(GuestRole, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@role.Name">@RoleLabel(role.Name)</option>
            }
        </select>
    </div>
    @if (_result.Users.Count == 0) { <div class="registry-surface"><RegistryEmpty Body="@T["users.empty"]" /></div> }
    else
    {
        <RbiTable AccessibleLabel="@T["users.title"]" Class="registry-table registry-users-table">
            <thead><tr><th scope="col">@T["users.user"]</th><th scope="col">@T["users.email"]</th><th scope="col">@T["users.col-accesses"]</th><th scope="col" class="registry-center">@T["users.status"]</th>@if (_canWrite) { <th scope="col" class="registry-center registry-actions-cell">@T["users.actions"]</th> }</tr></thead>
            <tbody>@foreach (var user in _result.Users)
            {
                <tr @key="user.Id"><td><strong>@user.FirstName @user.LastName</strong><br /><span class="registry-sub">@user.Username</span></td><td>@user.Email</td><td>@(user.IsActive && user.Roles.Count == 0 ? RoleLabel(GuestRole) : string.Join(", ", user.Roles.Select(RoleLabel)))@if (!user.IdentityConfirmed) { <br /><span class="registry-sub" data-identity="unconfirmed">@T["users.identity-unconfirmed"]</span> }</td><td class="registry-center"><Indicator Kind="@(user.IsActive ? "active" : "inactive")" Label="@T[user.IsActive ? "users.active" : "users.inactive"]" /></td>
                @if (_canWrite)
                {
                    <td class="registry-actions-cell"><div class="registry-row-actions">
                        <RbiButton Disabled="@(_busy || _refreshing || IsSelf(user))" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["users.roles-change"]" title="@T["users.roles-change"]" OnClick="() => Edit(user)"><AppIcon Name="AppIconName.UserCog" /></RbiButton>
                        <RbiButton Disabled="@(_busy || _refreshing || (user.IsActive && IsSelf(user)))" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T[user.IsActive ? "users.deactivate" : "users.reactivate"]" title="@T[user.IsActive ? "users.deactivate" : "users.reactivate"]" OnClick="() => Confirm(user, false)"><AppIcon Name="AppIconName.Power" /></RbiButton>
                        <RbiButton Disabled="@(_busy || _refreshing || IsSelf(user))" Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["users.delete"]" title="@T["users.delete"]" Class="registry-danger-icon" OnClick="() => Confirm(user, true)"><RbiIcon Name="RbiIconName.Trash2" /></RbiButton>
                    </div>@if (IsSelf(user)) { <p class="app-visually-hidden">@T["users.self-protected"]</p> }</td>
                }</tr>
            }</tbody>
        </RbiTable>
    }
    @if (TotalPages > 1)
    {
        <p class="page-total" role="status">@T.Format("legal.page-summary", _page, TotalPages, _result.Total)</p>
    <RbiPagination CurrentPage="_page" CurrentPageChanged="ChangePageAsync" TotalPages="TotalPages" AccessibleLabel="@T["users.pages"]" PreviousLabel="@T["common.back"]" PreviousAccessibleLabel="@T["legal.previous"]" NextLabel="@T["common.actions.continue"]" NextAccessibleLabel="@T["legal.next"]" PageAccessibleLabel="@(page => T.Format("legal.page", page))" />
    }
}
@if (_notice is not null) { <div @key="_noticeVersion" role="status" class="app-toast"><RbiAlert Tone="RbiAlertTone.Success" Title="@T[_notice]" /></div> }
@if (_draft is { } draft)
{
    <RbiDialog Open Class="app-form-dialog app-form-dialog--md registry-users-dialog" Title="@T[draft.Id is null ? "users.create" : "users.roles-edit"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="CloseEditor">
        <DialogBody><UserForm @key="draft" Model="draft" Save="SaveAsync" Cancel="() => CloseEditor(false)" /></DialogBody>
    </RbiDialog>
}
@if (_target is { } target)
{
    <RbiAlertDialog Open Class="@("registry-users-dialog" + (!_delete && !target.IsActive ? " app-confirm--primary" : ""))" Title="@T[_delete ? "users.delete-title" : target.IsActive ? "users.deactivate-title" : "users.reactivate-title"]" Description="@T.Format(_delete ? "users.delete-description" : "users.state-description", target.Username)" CancelLabel="@T["common.cancel"]" ConfirmLabel="@T[_delete ? "common.delete" : target.IsActive ? "users.deactivate" : "users.reactivate"]" Confirming="_busy" ConfirmLoadingLabel="@T["state.loading"]" OnConfirm="MutateAsync" OnCancel="CancelConfirmation" OpenChanged="CloseConfirmation" />
}
@code {
    private const string GuestRole = "gost";
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    public Users() => _token = _lifetime.Token;
    private UsersPage _result = new([], 0, 1, 20);
    private RolesCatalog _roles = new([]);
    private ApplicationProfile? _profile;
    private UserDraft? _draft;
    private ApplicationUser? _target;
    private string? _error;
    private string _search = "", _roleFilter = "";
    private CancellationTokenSource? _filterRequest;
    private int _page = 1;
    private bool _disposed, _authenticated, _canRead, _canWrite, _busy, _loading = true, _refreshing, _loaded, _delete;
    private string? _notice;
    private int _noticeVersion;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_result.Total / 20d));
    private string RoleLabel(string role) => T.Role(role);
    private bool IsSelf(ApplicationUser user) => _profile?.ApplicationUserId is { } id ? user.Id == id
        : !string.IsNullOrWhiteSpace(_profile?.Email) && string.Equals(_profile.Email.Trim(), user.Email.Trim(), StringComparison.OrdinalIgnoreCase);
    protected override Task OnInitializedAsync() => LoadAsync();
    private Task LoadAsync() => LoadAsync(_token);
    private async Task LoadAsync(CancellationToken token)
    {
        if (_disposed || _refreshing) return; _loading = !_loaded; _refreshing = true; _error = null;
        try
        {
            _authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            if (!_authenticated) return;
            _profile = await Profile.GetAsync(token);
            _canRead = ApplicationAccess.CanViewAdministration(_profile);
            _canWrite = ApplicationAccess.CanManageAdministration(_profile);
            if (!_canRead) return;
            if (!_loaded) _roles = await Api.RolesAsync(token);
            _result = await Api.ListAsync(_page, token, _search, _roleFilter);
            if (_page > TotalPages) { _page = TotalPages; _result = await Api.ListAsync(_page, token, _search, _roleFilter); }
            _loaded = true;
        }
        catch (RegistryApiException exception) { _error = exception.MessageKey; }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally { _loading = _refreshing = false; }
    }
    private Task SearchAsync(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? "";
        return ChangeFiltersAsync(debounce: true);
    }

    private Task FilterRoleAsync(ChangeEventArgs args)
    {
        _roleFilter = args.Value?.ToString() ?? "";
        return ChangeFiltersAsync(debounce: false);
    }

    private async Task ChangeFiltersAsync(bool debounce)
    {
        if (_disposed) return;
        _filterRequest?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_token);
        _filterRequest = request;
        try
        {
            if (debounce) await Task.Delay(250, request.Token);
            while (_refreshing || _busy) await Task.Delay(50, request.Token);
            request.Token.ThrowIfCancellationRequested();
            _page = 1;
            // Supersede the debounce. Once the read starts, finish it before applying the next filter.
            await LoadAsync(_token);
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally { if (ReferenceEquals(_filterRequest, request)) _filterRequest = null; }
    }

    private void Edit(ApplicationUser? user) { if (_canWrite && !_busy && !_refreshing && (user is null || !IsSelf(user))) _draft = UserDraft.From(user, _roles); }
    private void CloseEditor(bool open) { if (!open && !_busy) _draft = null; }
    private async Task<string?> SaveAsync(UserDraft draft)
    {
        if (!_canWrite) return "errors.forbidden";
        if (_busy) return null;
        _busy = true;
        _notice = null;
        try
        {
            StateHasChanged();
            if (draft.Id is { } id)
            {
                var current = _result.Users.SingleOrDefault(user => user.Id == id);
                if (current is null || IsSelf(current)) return "errors.forbidden";
                if (draft.ProfileChanged && await Api.UpdateProfileAsync(id, draft.Username.Trim(), draft.FirstName.Trim(),
                        draft.LastName.Trim(), draft.Email.Trim(), _token) is { } profileError)
                    return profileError;
                if (draft.RolesChanged(current) && await Api.UpdateRolesAsync(id, draft.SelectedRoles, _token) is { } roleError)
                    return roleError;
                _notice = "toast.user-role";
            }
            else
            {
                var result = await Api.CreateAsync(draft.ToRequest(), _token);
                if (result.User is not { } created) return result.ErrorKey ?? "errors.unavailable";
                _notice = created.IdentityConfirmed || draft.SelectedRoles.Length == 0 ? "toast.user-created" : "toast.user-created-pending";
            }
            _draft = null;
            _noticeVersion++;
            StateHasChanged();
            await LoadAsync();
            return null;
        }
        finally
        {
            _busy = false;
            if (!_disposed) StateHasChanged();
        }
    }
    private void Confirm(ApplicationUser user, bool permanent)
    {
        if (!_canWrite || _busy || _refreshing || (IsSelf(user) && (permanent || user.IsActive))) return;
        _target = user; _delete = permanent;
    }
    private Task CancelConfirmation() { if (!_busy) _target = null; return Task.CompletedTask; }
    private Task CloseConfirmation(bool open) => open ? Task.CompletedTask : CancelConfirmation();
    private async Task MutateAsync()
    {
        if (_target is not { } target || !_canWrite || _busy || (IsSelf(target) && (_delete || target.IsActive))) return;
        _busy = true;
        try
        {
            if (_delete) await Api.DeleteAsync(target.Id, _token); else await Api.SetActiveAsync(target.Id, !target.IsActive, _token);
            _notice = _delete ? "toast.user-deleted" : "toast.user-status";
            _noticeVersion++;
            _target = null;
            StateHasChanged();
            await LoadAsync();
        }
        catch (RegistryApiException exception) { _error = (int?)exception.StatusCode == 409 ? "users.safety-conflict" : exception.MessageKey; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; _target = null; }
    }
    private async Task ChangePageAsync(int page) { if (_busy || _refreshing || _filterRequest is not null || page < 1 || page > TotalPages) return; _page = page; await LoadAsync(); }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
