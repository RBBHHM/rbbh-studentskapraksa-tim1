@implements IDisposable
@inject ILegalEntitiesApi Api

<div class="app-typeahead">
    <input type="text" id="@Id" class="rbi-control rbi-input app-typeahead__input" autocomplete="off" maxlength="100" data-app-combobox
           role="combobox" aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")"
           aria-controls="@(Id + "-list")" aria-activedescendant="@ActiveId"
           placeholder="@T["legal.bank-placeholder"]" value="@_query"
           @oninput="TypedAsync" @onfocus="OpenList" @onblur="CloseList" @onkeydown="KeyAsync" />
    @if (_open)
    {
        <ul id="@(Id + "-list")" role="listbox" class="app-typeahead__list" aria-label="@T["legal.bank-results"]">
            @if (_searching) { <li class="app-typeahead__note" role="presentation">@T["limit.searching"]</li> }
            else if (_query.Trim().Length < 2) { <li class="app-typeahead__note" role="presentation">@T["legal.bank-type"]</li> }
            else if (_results.Count == 0) { <li class="app-typeahead__note" role="presentation">@T["limit.no-results"]</li> }
            @for (var index = 0; index < _results.Count; index++)
            {
                var item = _results[index]; var position = index;
                <li id="@(Id + "-option-" + position)" role="option" aria-selected="@(position == _active ? "true" : "false")"
                    class="app-typeahead__option" data-active="@(position == _active ? "true" : "false")"
                    @onmousedown:preventDefault @onclick="() => SelectAsync(item)">@item.Name — @item.TaxNumber — @item.Matbroj</li>
            }
        </ul>
    }
</div>
@if (_unavailable) { <p class="app-hint" role="status">@T["legal.bank-unavailable"]</p> }
@if (_selectedName is { Length: > 0 }) { <p class="app-hint">@T.Format("legal.bank-selected", _selectedName)</p> }

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public EventCallback<BankCustomerOption> Selected { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _typing;
    private IReadOnlyList<BankCustomerOption> _results = [];
    private string _query = "";
    private string? _selectedName;
    private bool _open, _searching, _unavailable;
    private int _active = -1;
    private string? ActiveId => _open && _active >= 0 && _active < _results.Count ? Id + "-option-" + _active : null;

    private void OpenList() => _open = true;
    private void CloseList() { _open = false; _active = -1; }
    private async Task TypedAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? "";
        _selectedName = null;
        _open = true; _active = -1;
        await SearchAsync();
    }
    private async Task SearchAsync()
    {
        _typing?.Cancel(); _typing?.Dispose();
        _typing = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _typing.Token;
        var query = _query.Trim();
        if (query.Length < 2)
        {
            _results = []; _searching = false; _unavailable = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        _searching = true;
        try
        {
            await Task.Delay(250, token);
            var result = await Api.CustomersAsync(query, token);
            token.ThrowIfCancellationRequested();
            _results = result.Items;
            _unavailable = false;
            _active = -1;
        }
        catch (RegistryApiException exception)
        {
            if (token.IsCancellationRequested) return;
            _results = []; _unavailable = (int?)exception.StatusCode == 503;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        finally
        {
            if (!token.IsCancellationRequested) { _searching = false; await InvokeAsync(StateHasChanged); }
        }
    }
    private async Task KeyAsync(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown": _open = true; if (_results.Count > 0) _active = (_active + 1) % _results.Count; break;
            case "ArrowUp": if (_results.Count > 0) _active = _active <= 0 ? _results.Count - 1 : _active - 1; break;
            case "Enter": if (_open && _active >= 0 && _active < _results.Count) await SelectAsync(_results[_active]); break;
            case "Escape": CloseList(); break;
        }
    }
    private async Task SelectAsync(BankCustomerOption item)
    {
        _open = false; _active = -1; _selectedName = item.Name;
        _query = string.Join(" — ", new[] { item.TaxNumber, item.Name }.Where(value => !string.IsNullOrWhiteSpace(value)));
        await Selected.InvokeAsync(item);
    }
    public void Dispose() { _lifetime.Cancel(); _typing?.Cancel(); _typing?.Dispose(); _lifetime.Dispose(); }
}
