@using RBI.DesignSystem.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS

<form id="codebook-schema-form" class="custom-codebook-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
    <fieldset disabled="@_busy">
        <legend class="app-visually-hidden">@T["codes.column-structure"]</legend>
        <div class="registry-form-grid">
            <div class="role-catalog-field">
                <label for="codebook-definition-name">@T["codes.definition-name"]</label>
                <RbiInput Id="codebook-definition-name" Invalid="@(Error == "codes.definition-range")" @bind-Value="_name" ReadOnly="@(Existing is not null)" maxlength="100" Required />
            </div>
            <div class="role-catalog-field">
                <label for="codebook-definition-purpose">@T["codes.purpose"]</label>
                <RbiInput Id="codebook-definition-purpose" @bind-Value="_description" maxlength="500" />
            </div>
        </div>
        <section class="codebook-schema-columns" aria-labelledby="codebook-add-column">
            <h3 id="codebook-add-column">@T["codes.schema-add-column"]</h3>
            <div class="codebook-type-buttons" role="group" aria-labelledby="codebook-add-column">
                @foreach (var group in SlotGroups)
                {
                    <RbiButton Variant="RbiButtonVariant.Secondary" Disabled="@(AvailableSlot(group) == 0)" title="@TypeDetails(group[0])" OnClick="() => AddColumn(group)">
                        + @TypeLabel(group[0])
                    </RbiButton>
                }
            </div>
            <ol class="codebook-schema-list">
                @for (var index = 0; index < _columns.Count; index++)
                {
                    var column = _columns[index];
                    var position = index;
                    var inputId = $"codebook-column-name-{column.Slot}";
                    <li @key="column.Slot">
                        <div class="codebook-schema-row">
                            <div class="role-catalog-field">
                                <label for="@inputId">@T["codes.schema-name-limit"]</label>
                                <span class="app-hint">@T[CodebookField.TypeKey(column.Slot)] · @TypeDetails(column.Slot)</span>
                                <RbiInput Id="@inputId" Invalid="@(_invalidSlots.Contains(column.Slot))" @bind-Value="column.Name" UpdateMode="RbiInputUpdateMode.Input" maxlength="128" Required />
                            </div>
                            <div class="codebook-type-buttons">
                                <RbiButton Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly Disabled="@(position == 0)" AccessibleLabel="@T["codes.schema-move-up"]" title="@T["codes.schema-move-up"]" OnClick="() => Move(position, -1)">↑</RbiButton>
                                <RbiButton Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly Disabled="@(position == _columns.Count - 1)" AccessibleLabel="@T["codes.schema-move-down"]" title="@T["codes.schema-move-down"]" OnClick="() => Move(position, 1)">↓</RbiButton>
                                @if (!HasValues || !Columns.Any(saved => saved.Slot == column.Slot))
                                {
                                    <RbiButton Variant="RbiButtonVariant.Ghost" Size="RbiButtonSize.Icon" IconOnly AccessibleLabel="@T["codes.schema-remove-column"]" title="@T["codes.schema-remove-column"]" OnClick="() => { _columns.Remove(column); }">
                                        <RbiIcon Name="RbiIconName.Trash2" />
                                    </RbiButton>
                                }
                            </div>
                        </div>
                        <div class="role-catalog-field codebook-schema-description">
                            <label for="@($"codebook-description-{column.Slot}")">@T["codes.schema-description-limit"]</label>
                            <RbiTextArea Id="@($"codebook-description-{column.Slot}")" @bind-Value="column.Description" Rows="1" maxlength="4000" />
                        </div>
                    </li>
                }
            </ol>
        </section>
    </fieldset>
    <div class="codebook-schema-footer">
        @if (Error is not null)
        {
            <div id="codebook-schema-error" tabindex="-1"><RbiAlert Tone="RbiAlertTone.Danger" Title="@T[Error]" Announcement="RbiAlertAnnouncement.Assertive" /></div>
        }
        <div class="registry-toolbar">
            <RbiButton Variant="RbiButtonVariant.Secondary" OnClick="Cancel" Disabled="_busy">@T["common.cancel"]</RbiButton>
            <RbiButton Type="RbiButtonType.Submit" Disabled="_busy">@T[Existing is null ? "codes.create-submit" : "common.save"]</RbiButton>
        </div>
    </div>
</form>

@code {
    [Parameter] public CodeListMeta? Existing { get; set; }
    [Parameter] public IReadOnlyList<CodebookColumn> Columns { get; set; } = [];
    [Parameter] public bool HasValues { get; set; }
    [Parameter, EditorRequired] public Func<string, string?, IReadOnlyList<CodebookColumnInput>, Task<string?>> Save { get; set; } = null!;
    [Parameter] public EventCallback Cancel { get; set; }

    private static readonly int[][] SlotGroups =
    [
        [12], [14, 15], [13], [16, 17, 18, 19, 20], [2, 1], [3, 4, 5], [6, 7], [8], [9, 10], [11]
    ];

    private sealed class ColumnDraft(int slot, string? name = null, string? description = null)
    {
        public int Slot { get; } = slot;
        public string? Name { get; set; } = name;
        public string? Description { get; set; } = description;
    }

    private readonly List<ColumnDraft> _columns = [];
    private string? _name, _description, Error;
    private bool _busy, _focusError;
    private readonly HashSet<int> _invalidSlots = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusError) return;
        _focusError = false;
        await JS.InvokeVoidAsync("appFocus.invalidOrSummary", "codebook-schema-form", "codebook-schema-error");
    }

    protected override void OnInitialized()
    {
        _name = Existing?.Name;
        _description = Existing?.Description;
        _columns.AddRange(Columns.OrderBy(column => column.Position ?? column.Slot)
            .Select(column => new ColumnDraft(column.Slot, column.Name, column.Description)));
    }

    private string TypeLabel(int slot)
    {
        var label = T[CodebookField.TypeKey(slot)];
        return slot switch
        {
            >= 12 => $"{label} · {TypeDetails(slot)}",
            6 or 7 => $"{label} (18,2)",
            8 => $"{label} (19,6)",
            _ => label
        };
    }

    private string TypeDetails(int slot) => slot switch
    {
        1 or 2 => T["codes.type-boolean-limit"],
        >= 3 and <= 5 => T["codes.type-integer-limit"],
        6 or 7 => T.Format("codes.type-decimal-limit", 16, 2),
        8 => T.Format("codes.type-decimal-limit", 13, 6),
        9 or 10 => T["codes.type-date-limit"],
        11 => T["codes.type-datetime-limit"],
        _ => T.Format("codes.type-text-limit", CodebookField.TextLimit(slot))
    };

    private int AvailableSlot(int[] group) => group.FirstOrDefault(slot => _columns.All(column => column.Slot != slot));

    private void AddColumn(int[] group)
    {
        var slot = AvailableSlot(group);
        if (slot != 0) _columns.Add(new ColumnDraft(slot));
    }

    private void Move(int position, int direction)
    {
        var target = position + direction;
        (_columns[position], _columns[target]) = (_columns[target], _columns[position]);
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        Error = null;
        _invalidSlots.Clear();
        if (_name?.Trim() is not { Length: >= 2 and <= 100 } name)
        {
            Error = "codes.definition-range";
            _focusError = true;
            return;
        }
        var columns = _columns.Select((column, index) =>
            new CodebookColumnInput(column.Slot, column.Name?.Trim() ?? "", column.Description, index + 1)).ToArray();
        if (columns.Length == 0)
        {
            Error = "codes.schema-empty";
            _focusError = true;
            return;
        }
        foreach (var column in columns.Where(column => column.Name.Length is < 1 or > 128 ||
                     column.Name[0] is '=' or '+' or '-' or '@' || column.Name.Any(char.IsControl)))
            _invalidSlots.Add(column.Slot);
        foreach (var group in columns.GroupBy(column => column.Name, StringComparer.OrdinalIgnoreCase).Where(group => group.Count() > 1))
            _invalidSlots.UnionWith(group.Select(column => column.Slot));
        if (_invalidSlots.Count > 0)
        {
            Error = "codes.schema-name-invalid";
            _focusError = true;
            return;
        }
        _busy = true;
        try { Error = await Save(name, _description, columns); _focusError = Error is not null; }
        finally { _busy = false; }
    }
}
