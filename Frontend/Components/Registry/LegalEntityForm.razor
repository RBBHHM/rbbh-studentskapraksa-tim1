@using RBI.DesignSystem.Components.Forms
@using RBI.Forms
@implements IDisposable

<EditForm EditContext="_context" OnSubmit="SubmitAsync" FormName="legal-entity" novalidate>
    <fieldset disabled="@_submission.IsSubmitting">
        <legend class="app-visually-hidden">@T["legal.details"]</legend>
        <div class="registry-form-grid">
            <RbiField TValue="string" Label="@T["legal.name"]" Required For="@(() => Model.Name)"><RbiInput @bind-Value="Model.Name" maxlength="100" /></RbiField>
            <RbiRadioGroup TValue="bool?" Label="@T["person.residency"]" Required @bind-Value="Model.IsResident" @bind-Value:after="Model.ResidencyChanged">
                <RbiRadio TValue="bool?" Value="@((bool?)true)">@T["person.resident"]</RbiRadio><RbiRadio TValue="bool?" Value="@((bool?)false)">@T["person.nonresident"]</RbiRadio>
            </RbiRadioGroup>
            <RbiField TValue="string" Label="@T["legal.tax"]" Required="@(Model.IsResident == true)" Disabled="@(Model.IsResident == false)" For="@(() => Model.TaxNumber)"><RbiInput @bind-Value="Model.TaxNumber" maxlength="13" inputmode="numeric" /></RbiField>
            <RbiField TValue="string" Label="@T["legal.registration"]" For="@(() => Model.MaticniBroj)"><RbiInput @bind-Value="Model.MaticniBroj" maxlength="50" inputmode="numeric" /></RbiField>
            <RbiField TValue="string" Label="@T["person.fba"]" Required="@(Model.IsResident == false)" Disabled="@(Model.IsResident == true)" For="@(() => Model.FbaId)"><RbiInput @bind-Value="Model.FbaId" maxlength="10" inputmode="numeric" /></RbiField>
            <RbiField TValue="string" Label="@T["person.basis"]" Required For="@(() => Model.BasisOfConnection)">
                <RbiSelect TValue="string" @bind-Value="Model.BasisOfConnection" @bind-Value:after="BasisChanged"><option value="">@T["common.select"]</option>
                    @foreach (var option in Bases) { <option value="@option.Kod">@option.Naziv</option> }
                </RbiSelect>
            </RbiField>
            <RbiField TValue="string" Label="@T["person.description"]" Required For="@(() => Model.ConnectionDescription)"><RbiTextArea @bind-Value="Model.ConnectionDescription" ReadOnly /></RbiField>
            <RbiRadioGroup TValue="bool?" Label="@T["person.connected-bank"]" Required @bind-Value="Model.ConnectedWithBank">
                <RbiRadio TValue="bool?" Value="@((bool?)true)">@T["common.yes"]</RbiRadio><RbiRadio TValue="bool?" Value="@((bool?)false)">@T["common.no"]</RbiRadio>
            </RbiRadioGroup>
            <RbiField TValue="DateTime?" Id="legal-from" Label="@T["person.from"]" Required For="@(() => Model.DateFrom)"><InputDate TValue="DateTime?" id="legal-from" class="rbi-control" @bind-Value="Model.DateFrom" ParsingErrorMessage="@T["validation.date"]" /></RbiField>
            <RbiField TValue="DateTime?" Id="legal-to" Label="@T["person.to"]" For="@(() => Model.DateTo)"><InputDate TValue="DateTime?" id="legal-to" class="rbi-control" @bind-Value="Model.DateTo" ParsingErrorMessage="@T["validation.date"]" /></RbiField>
        </div>
    @if (FormErrors.Any())
        {
            <div role="alert" tabindex="-1" @ref="_summary" class="rbi-field__message">@foreach (var message in FormErrors) { <p>@message</p> }</div>
        }
        <div class="registry-toolbar">
            <RbiButton OnClick="Cancel" Variant="RbiButtonVariant.Secondary">@T["common.cancel"]</RbiButton>
            <RbiButton Type="RbiButtonType.Submit" Disabled="@(MutationBlocked || Incomplete)">@T["common.save"]</RbiButton>
        </div>
    </fieldset>
</EditForm>

@code {
    [Parameter] public bool MutationBlocked { get; set; }
    [Parameter, EditorRequired] public LegalEntityDraft Model { get; set; } = null!;
    [Parameter] public IReadOnlyList<ReferenceOption> Bases { get; set; } = [];
    [Parameter] public EventCallback<LegalEntityRequest> Save { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private EditContext _context = null!;
    private RbiServerValidation _validation = null!;
    private readonly RbiFormSubmissionState _submission = new();
    private ElementReference _summary;
    private bool _focusErrors;
    private readonly HashSet<string> _touched = [];
    private bool Incomplete => _touched.Count > 0 && Model.Validate().Count > 0;
    private IEnumerable<string> FormErrors => _context.GetValidationMessages(new FieldIdentifier(Model, string.Empty));
    protected override void OnInitialized()
    {
        _context = new(Model); _validation = new(_context);
        _context.OnFieldChanged += ShowLiveErrors;
        _context.OnValidationStateChanged += Refresh;
    }
    private void Refresh(object? sender, ValidationStateChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    // Immediate feedback: validate on every field change and show messages for fields the user has touched.
    private void ShowLiveErrors(object? sender, FieldChangedEventArgs args)
    {
        _touched.Add(args.FieldIdentifier.FieldName);
        if (args.FieldIdentifier.FieldName == nameof(Model.IsResident)) { _touched.Add(nameof(Model.TaxNumber)); _touched.Add(nameof(Model.FbaId)); }
        if (args.FieldIdentifier.FieldName == nameof(Model.BasisOfConnection)) _touched.Add(nameof(Model.ConnectionDescription));
        var visible = Model.Validate().Where(item => _touched.Contains(item.Key))
            .ToDictionary(item => item.Key, item => item.Value.Select(key => T[key]).ToArray());
        _validation.DisplayErrors(visible);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusErrors) { _focusErrors = false; await _summary.FocusAsync(); }
    }
    private void BasisChanged() => Model.ConnectionDescription = Bases.FirstOrDefault(item => item.Kod == Model.BasisOfConnection)?.Opis;
    private async Task SubmitAsync() => await _submission.SubmitAsync(async () =>
    {
        if (MutationBlocked) return;
        var parsed = _context.Validate();
        var errors = Model.Validate();
        _validation.DisplayErrors(errors.ToDictionary(item => item.Key, item => item.Value.Select(key => T[key]).ToArray()));
        if (!parsed || errors.Count > 0) { _focusErrors = true; return; }
        try { await Save.InvokeAsync(Model.ToRequest()); }
        catch (RegistryApiException exception) { _validation.DisplayFormError(T[exception.MessageKey]); _focusErrors = true; }
        catch (OperationCanceledException) { /* The owning route cancels its request on disposal. */ }
    });
    public void Dispose() { _context.OnFieldChanged -= ShowLiveErrors; _context.OnValidationStateChanged -= Refresh; _validation.Dispose(); }
}
