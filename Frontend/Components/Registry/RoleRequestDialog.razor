@using RBI.DesignSystem.Components.Forms
@implements IDisposable
@inject IRoleRequestsApi Api
@inject IProfileApi Profile

@if (Open)
{
    <RbiDialog Open Class="registry-period-dialog role-request-dialog" Title="@T[Purpose == "change" ? "roles.change-title" : "roles.request-title"]" CloseLabel="@T["common.close"]" Dismissible="@(!_busy)" OpenChanged="OpenChangedAsync">
        <DialogBody>
            @if (_loading) { <div role="status"><RbiText>@T["state.loading"]</RbiText><RbiSkeleton /></div> }
            else if (_loadFailed) { <RbiAlert Tone="RbiAlertTone.Danger" Title="@T["roles.options-unavailable"]" /><RbiButton OnClick="LoadAsync">@T["state.retry"]</RbiButton> }
            else
            {
                <form class="role-request-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
                    <p class="role-request-intro">@T[Purpose == "change" ? "roles.change-review-help" : "roles.request-help"]</p>
                    <fieldset class="role-request-fields" disabled="@_busy">
                        <legend class="@(Purpose == "new" ? "app-required-legend" : "app-label")">@T["roles.choose"]</legend>
                        <div class="role-request-choices">
                            @foreach (var choice in _choices)
                            {
                                <label class="role-request-choice" @key="choice.Id">
                                    <input type="checkbox" @bind="choice.Selected" />
                                    <span>@choice.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                    <div class="role-request-note-field">
                        <label class="app-label" for="role-request-note">@T["roles.request-note-optional"]</label>
                        <textarea id="role-request-note" class="rbi-textarea role-request-note" rows="3" maxlength="1000" disabled="@_busy" @bind="_note" @bind:event="oninput" placeholder="@T["roles.note-placeholder"]"></textarea>
                    </div>
                    @if (_error is not null) { <RbiAlert Tone="RbiAlertTone.Danger" Announcement="RbiAlertAnnouncement.Assertive" Title="@T[_error]" /> }
                    <div class="role-request-actions">
                        <RbiButton OnClick="() => OpenChangedAsync(false)" Variant="RbiButtonVariant.Secondary" Disabled="_busy">@T["common.cancel"]</RbiButton>
                        <RbiButton Type="RbiButtonType.Submit" Disabled="@(_busy || !CanSubmit)">@T["roles.send"]</RbiButton>
                    </div>
                </form>
            }
        </DialogBody>
    </RbiDialog>
}
@code {
    /// <summary>"new" adds the chosen roles to the current ones; "change" replaces the explicit roles.</summary>
    [Parameter] public string Purpose { get; set; } = "new";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback Submitted { get; set; }
    private sealed class Choice { public long Id { get; init; } public string Label { get; init; } = ""; public bool Selected { get; set; } }
    private readonly CancellationTokenSource _lifetime = new();
    private List<Choice> _choices = [];
    private string _note = "";
    private string? _error;
    private bool _loading, _loadFailed, _busy, _wasOpen;
    private Guid _clientRequestId = Guid.NewGuid();
    private bool CanSubmit => Purpose == "change" || _choices.Any(choice => choice.Selected);
    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen) { _wasOpen = true; _clientRequestId = Guid.NewGuid(); _note = ""; _error = null; await LoadAsync(); }
        else if (!Open) _wasOpen = false;
    }
    private async Task LoadAsync()
    {
        _loading = true; _loadFailed = false;
        try
        {
            var optionsTask = Api.OptionsAsync(_lifetime.Token);
            HashSet<string> current = new(StringComparer.OrdinalIgnoreCase);
            if (Purpose == "change")
            {
                var profileTask = Profile.GetAsync(_lifetime.Token);
                await Task.WhenAll(optionsTask, profileTask);
                current.UnionWith((await profileTask).Roles);
            }

            var options = await optionsTask;
            _choices = options.Items.Select(role => new Choice { Id = role.Id, Label = string.IsNullOrWhiteSpace(role.DisplayName) || role.DisplayName.Equals(role.Name, StringComparison.OrdinalIgnoreCase) ? T.Role(role.Name) : role.DisplayName, Selected = Purpose == "change" && current.Contains(role.Name) }).ToList();
        }
        catch (RegistryApiException) { _loadFailed = true; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }
    private async Task OpenChangedAsync(bool open) { if (!open && _busy) return; await OpenChanged.InvokeAsync(open); }
    private async Task SubmitAsync()
    {
        if (_busy || !CanSubmit) return; _busy = true; _error = null;
        try
        {
            var result = await Api.SubmitAsync(_clientRequestId, Purpose, _choices.Where(choice => choice.Selected).Select(choice => choice.Id).ToArray(), string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(), _lifetime.Token);
            if (result.ErrorKey is { } error)
            {
                _error = error;
                return;
            }
            await OpenChanged.InvokeAsync(false);
            await Submitted.InvokeAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
