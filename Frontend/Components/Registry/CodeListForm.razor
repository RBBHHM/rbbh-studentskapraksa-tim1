@using RBI.DesignSystem.Components.Forms
@using RBI.Forms
@implements IDisposable

<EditForm EditContext="_context" OnSubmit="SubmitAsync" FormName="code-list-editor" class="registry-codes-form" novalidate>
    <fieldset disabled="@_submission.IsSubmitting">
        <legend class="app-visually-hidden">@T[Model.Definition ? "codes.definition-create" : Model.Id is null ? "codes.create" : "codes.edit"]</legend>
        <div class="registry-form-grid">
        @if (Model.IsLanguagePack)
        {
            <RbiField TValue="string" Id="code-language" Label="@T["codes.language-code"]" Required For="@(() => Model.LanguageCode)"><RbiInput Id="code-language" @bind-Value="Model.LanguageCode" Disabled="@(Model.Id is not null)" maxlength="10" /></RbiField>
            <RbiField TValue="string" Id="code-resource" Label="@T["codes.resource-key"]" Required For="@(() => Model.ResourceKey)"><RbiInput Id="code-resource" @bind-Value="Model.ResourceKey" Disabled="@(Model.Id is not null)" maxlength="200" /></RbiField>
            <RbiField Class="app-span-2" TValue="string" Id="code-label" Label="@T["codes.label-text"]" Required For="@(() => Model.Name)"><RbiTextArea Id="code-label" @bind-Value="Model.Name" maxlength="4000" /></RbiField>
            <RbiField TValue="string" Id="code-context" Label="@T["codes.context-info"]" For="@(() => Model.ContextInfo)"><RbiInput Id="code-context" @bind-Value="Model.ContextInfo" maxlength="100" /></RbiField>
            <RbiField TValue="string" Id="code-placeholder" Label="@T["codes.placeholder-text"]" For="@(() => Model.Placeholder)"><RbiInput Id="code-placeholder" @bind-Value="Model.Placeholder" maxlength="4000" /></RbiField>
            <RbiField Class="app-span-2" TValue="string" Id="code-helper" Label="@T["codes.help-text"]" For="@(() => Model.Helper)"><RbiTextArea Id="code-helper" @bind-Value="Model.Helper" maxlength="4000" /></RbiField>
        }
        else
        {
        <RbiField Class="app-span-2" TValue="string" Id="code-name" Label="@T[Model.Definition ? "codes.definition-name" : "codes.name"]" Required For="@(() => Model.Name)"><RbiInput Id="code-name" @bind-Value="Model.Name" maxlength="@(Model.Definition ? 100 : 200)" /></RbiField>
        @if (!Model.Definition)
        {
            <RbiField TValue="string" Id="code-key" Label="@T["codes.code"]" Required For="@(() => Model.Code)"><RbiInput Id="code-key" @bind-Value="Model.Code" Disabled="@(Model.Id is not null)" maxlength="50" /></RbiField>

        }
        <RbiField TValue="string" Id="code-description" Label="@T[Model.Definition ? "codes.purpose" : "codes.description"]" For="@(() => Model.Description)"><RbiTextArea Id="code-description" @bind-Value="Model.Description" maxlength="500" /></RbiField>
        }
        @if (!Model.Definition) { <RbiCheckbox @bind-Value="Model.Active">@T["codes.active"]</RbiCheckbox> }
        </div>
        @if (!Model.Definition) { <p class="app-visually-hidden">@T["codes.immutable"]</p> }
    <FormSummary @ref="_summary" Context="_context" />
        <div class="registry-toolbar"><RbiButton OnClick="Cancel" Variant="RbiButtonVariant.Secondary">@T["common.cancel"]</RbiButton><RbiButton Type="RbiButtonType.Submit" Disabled="_live.Incomplete">@T[Model.Definition ? "codes.create-submit" : "common.save"]</RbiButton></div>
    </fieldset>
</EditForm>
@code {
    [Parameter, EditorRequired] public CodeListDraft Model { get; set; } = null!;
    [Parameter] public EventCallback<CodeListDraft> Save { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private EditContext _context = null!;
    private RbiServerValidation _validation = null!;
    private readonly RbiFormSubmissionState _submission = new();
    private FormSummary _summary = null!;
    private bool _focusErrors;
    private LiveValidation _live = null!;
    protected override void OnInitialized()
    {
        _context = new(Model); _validation = new(_context);
        _live = new(_context, _validation, () => Model.Validate(), key => T[key], () => _ = InvokeAsync(StateHasChanged));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_focusErrors) { _focusErrors = false; await _summary.FocusAsync(); } }
    private async Task SubmitAsync() => await _submission.SubmitAsync(async () =>
    {
        if (!Model.Definition && Model.Id is null) Model.Code = Model.Code.ToUpperInvariant();
        var parsed = _context.Validate(); var errors = Model.Validate();
        _validation.DisplayErrors(errors.ToDictionary(item => item.Key, item => item.Value.Select(key => T[key]).ToArray()));
        if (!parsed || errors.Count > 0) { _focusErrors = true; return; }
        try { await Save.InvokeAsync(Model); if (Model.SaveError is not null) { _validation.DisplayFormError(T[Model.SaveError]); _focusErrors = true; } }
        catch (RegistryApiException exception) { _validation.DisplayFormError(T[exception.StatusCode is null || (int)exception.StatusCode >= 500 ? "period.uncertain" : exception.MessageKey]); _focusErrors = true; }
        catch (OperationCanceledException) { }
    });
    public void Dispose() { _live.Dispose(); _validation.Dispose(); }
}
