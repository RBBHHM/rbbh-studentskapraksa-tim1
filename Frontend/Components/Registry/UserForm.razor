@using RBI.DesignSystem.Components.Forms
@using RBI.Forms
@implements IDisposable

<EditForm EditContext="_context" OnSubmit="SubmitAsync" FormName="application-user" class="registry-user-form" novalidate>
    <fieldset disabled="@_submission.IsSubmitting">
        <legend class="app-visually-hidden">@T[Model.Id is null ? "users.create" : "users.edit"]</legend>
        {
            <div class="registry-form-grid">
                <RbiField TValue="string" Id="user-username" Label="@T["users.username"]" Required For="@(() => Model.Username)"><RbiInput Id="user-username" @bind-Value="Model.Username" @bind-Value:after="Model.UsernameChanged" maxlength="100" /></RbiField>
                <RbiField TValue="string" Id="user-firstname" Label="@T["person.first-name"]" Required For="@(() => Model.FirstName)"><RbiInput Id="user-firstname" @bind-Value="Model.FirstName" maxlength="100" /></RbiField>
                <RbiField TValue="string" Id="user-lastname" Label="@T["person.last-name"]" Required For="@(() => Model.LastName)"><RbiInput Id="user-lastname" @bind-Value="Model.LastName" maxlength="100" /></RbiField>
                <RbiField TValue="string" Id="user-email" Label="@T["users.email"]" Required For="@(() => Model.Email)"><RbiInput Id="user-email" @bind-Value="Model.Email" Type="RbiInputType.Email" /></RbiField>
            </div>
        }
        <fieldset class="registry-user-fieldset"><legend class="app-required-legend">@T["users.accesses"]</legend><p>@T["users.multiple"]</p>
            <div class="registry-user-accesses">@foreach (var choice in Model.Roles)
            {
                <RbiCheckbox @key="choice.Id" @bind-Value="choice.Selected">@T.Role(choice.Name)</RbiCheckbox>
            }</div>
            <ValidationMessage For="@(() => Model.Roles)" />
            @if (Model.SelectedRoles.Length == 0) { <p class="registry-help">@T["users.empty-roles"]</p> }
            @if (Model.SelectedRoles.Length == 0) { <p>@T["users.empty-roles-detail"]</p> }
        </fieldset>
    <FormSummary @ref="_summary" Context="_context" />
        <div class="registry-toolbar"><RbiButton OnClick="Cancel" Variant="RbiButtonVariant.Secondary">@T["common.cancel"]</RbiButton><RbiButton Type="RbiButtonType.Submit" Disabled="_live.Incomplete">@T["common.save"]</RbiButton></div>
    </fieldset>
</EditForm>
@code {
    [Parameter, EditorRequired] public UserDraft Model { get; set; } = null!;
    [Parameter] public EventCallback<UserDraft> Save { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private EditContext _context = null!;
    private RbiServerValidation _validation = null!;
    private readonly RbiFormSubmissionState _submission = new();
    private FormSummary _summary = null!;
    private bool _focusErrors;
    private LiveValidation _live = null!;
    protected override void OnInitialized()
    {
        _context = new(Model); _validation = new(_context);
        _live = new(_context, _validation, () => Model.Validate(), key => T[key], () => _ = InvokeAsync(StateHasChanged));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_focusErrors) { _focusErrors = false; await _summary.FocusAsync(); } }
    private async Task SubmitAsync() => await _submission.SubmitAsync(async () =>
    {
        var parsed = _context.Validate(); var errors = Model.Validate();
        _validation.DisplayErrors(errors.ToDictionary(item => item.Key, item => item.Value.Select(key => T[key]).ToArray()));
        if (!parsed || errors.Count > 0) { _focusErrors = true; return; }
        try { await Save.InvokeAsync(Model); }
        catch (RegistryApiException exception) { _validation.DisplayFormError(T[(int?)exception.StatusCode == 409 ? "users.safety-conflict" : exception.MessageKey]); _focusErrors = true; }
        catch (OperationCanceledException) { }
    });
    public void Dispose() { _live.Dispose(); _validation.Dispose(); }
}
