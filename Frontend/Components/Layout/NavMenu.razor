@implements IDisposable
@inject NavigationManager Navigation
@inject IProfileApi Profile
@inject AuthenticationStateProvider AuthenticationState

<div class="app-nav">
    <div class="app-nav__areas">
        <div class="app-nav__area">
            <p class="app-nav__eyebrow">@T["nav.area.work"]</p>
            <nav class="app-nav__list" aria-label="@T["nav.area.work"]">
                <NavEntry Label="@T["nav.home"]" Href="/app" Icon="RbiIconName.Gauge" Active="@(IsActive("app") || IsActive(""))" />
                @if (_legal) { <NavEntry Label="@T["legal.title"]" Href="/app/legal-persons" Icon="RbiIconName.Building2" Active="@IsActive("app/legal-persons")" /> }
                @if (_physical) { <NavEntry Label="@T["person.title"]" Href="/app/physical-persons" Icon="RbiIconName.UserRound" Active="@IsActive("app/physical-persons")" /> }
                @if (_limits) { <NavEntry Label="@T["limit.title"]" Href="/app/limits" Glyph="AppIconName.Scale" Active="@IsActive("app/limits")" /> }
                @if (_capital) { <NavEntry Label="@T["capital.title"]" Href="/app/capital" Glyph="AppIconName.Landmark" Active="@IsActive("app/capital")" /> }
                @if (_reports) { <NavEntry Label="@T["reports.title"]" Href="/app/reports" Glyph="AppIconName.FileChartColumn" Active="@IsActive("app/reports")" /> }
            </nav>
        </div>
        @if (_admin || _periodLock)
        {
            <div class="app-nav__area">
                <p class="app-nav__eyebrow">@T["nav.area.administration"]</p>
                <nav class="app-nav__list" aria-label="@T["nav.area.administration"]">
                    @if (_admin)
                    {
                        <NavEntry Label="@T["users.title"]" Href="/app/admin/users" Icon="RbiIconName.Users" Active="@IsActive("app/admin/users")" />
                        <NavEntry Label="@T["roles.admin-title"]" Href="/app/admin/role-requests" Glyph="AppIconName.UserCog" Active="@IsActive("app/admin/role-requests")" />
                        <NavEntry Label="@T["rolecatalog.title"]" Href="/app/admin/role-catalog" Glyph="AppIconName.UserCog" Active="@IsActive("app/admin/role-catalog")" />
                        <NavEntry Label="@T["codes.title"]" Href="/app/admin/code-lists" Glyph="AppIconName.BookOpen" Active="@IsActive("app/admin/code-lists")" />
                        <NavEntry Label="@T["audit.title"]" Href="/app/admin/audit" Glyph="AppIconName.ScrollText" Active="@IsActive("app/admin/audit")" />
                    }
                    @if (_periodLock)
                    {
                        <NavEntry Label="@T["period.title"]" Href="/app/admin/period" Glyph="AppIconName.CalendarClock" Active="@IsActive("app/admin/period")" />
                    }
                </nav>
            </div>
        }
    </div>
    <AuthorizeView><Authorized>
        <nav class="app-nav__footer" aria-label="@T["guide.title"]">
            <NavEntry Label="@T["guide.title"]" Href="/app/guide" Glyph="AppIconName.BookOpenCheck" Active="@IsActive("app/guide")" />
            <NavEntry Label="@T["release.title"]" Href="/app/release-notes" Glyph="AppIconName.FileChartColumn" Active="@IsActive("app/release-notes")" />
        </nav>
    </Authorized></AuthorizeView>
</div>

@code {
    private bool _physical, _legal, _limits, _capital, _admin, _periodLock, _reports;
    private readonly LatestPageRequest _accessRequest = new();
    private readonly CancellationTokenSource _lifetime = new();

    protected override Task OnInitializedAsync()
    {
        Navigation.LocationChanged += RouteChanged;
        return LoadAccessAsync();
    }

    private Task LoadAccessAsync() => _accessRequest.RunAsync(_lifetime.Token, false, async token =>
    {
        if ((await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated != true)
        {
            ClearAccess();
            return;
        }

        var access = await ApplicationNavigationAccess.ReadAsync(Profile, token);
        token.ThrowIfCancellationRequested();
        (_admin, _periodLock, _reports, _physical, _legal, _limits, _capital) =
            (access.Administration, access.PeriodLock, access.Reports, access.Physical, access.Legal, access.Limits, access.Capital);
    }, _ => ClearAccess(), () => { if (!_lifetime.IsCancellationRequested) StateHasChanged(); });

    private void ClearAccess() => _physical = _legal = _limits = _capital = _admin = _periodLock = _reports = false;
    private void RouteChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        if (_lifetime.IsCancellationRequested) return;
        StateHasChanged();
        await LoadAccessAsync();
    });

    public void Dispose()
    {
        Navigation.LocationChanged -= RouteChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
    private bool IsActive(string path) => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') == path;
}
