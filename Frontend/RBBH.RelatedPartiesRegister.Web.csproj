<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);Platform/**</DefaultItemExcludes>
    <UserSecretsId>rbbh-webapp-16f22a6a-7621-42b8-8523-7d710990540b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Platform/RBI.DesignSystem/RBI.DesignSystem.csproj" />
    <ProjectReference Include="Platform/RBI.Hosting/RBI.Hosting.csproj" />
    <ProjectReference Include="Platform/RBI.ApiCore/RBI.ApiCore.csproj" />
    <ProjectReference Include="Platform/RBI.Authentication/RBI.Authentication.csproj" />
    <ProjectReference Include="Platform/RBI.Forms/RBI.Forms.csproj" />
    <ProjectReference Include="Platform/RBI.Authorization/RBI.Authorization.csproj" />
    <ProjectReference Include="Platform/RBI.Localization/RBI.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localization/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
