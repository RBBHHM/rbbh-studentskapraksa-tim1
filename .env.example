# Backend local Development only. Copy to Backend/.env; never commit .env.
ASPNETCORE_ENVIRONMENT=Development

# Optional SQL - leave blank for Development InMemory
Database__ServerName=
Database__Name=
Database__IntegratedSecurity=true
Database__User=
Database__Password=

# Development backend authentication fallback
KeycloakSettings__Enabled=false
KeycloakSettings__Issuer=
KeycloakSettings__Audience=
KeycloakSettings__ClientId=
KeycloakSettings__ClientSecret=

Email__Provider=demo

# Frontend: prefer dotnet user-secrets with Frontend/RBBH.RelatedPartiesRegister.Web.csproj.
# Configure Apis:BaseUrl and Authentication:Authority/ClientId/ClientSecret separately.
# This file does not configure production or provide an authenticated demo identity.
